#!/usr/bin/env bash
set -euo pipefail

BASE_DIR="${LARK_CODEX_BASE_DIR:-$HOME/.lark-codex}"
CRED_FILE="${LARK_CODEX_CREDENTIALS:-$BASE_DIR/.env}"
CODEX_WORKDIR="${LARK_CODEX_WORKDIR:-$HOME}"
COMMAND_PREFIX="${LARK_CODEX_COMMAND_PREFIX:-/codex}"
ALLOWED_SENDER="${LARK_CODEX_ALLOWED_SENDER:-}"
MAX_REPLY_CHARS="${LARK_CODEX_MAX_REPLY_CHARS:-12000}"
OUTPUT_LIMIT_CHARS_DEFAULT="${LARK_CODEX_OUTPUT_LIMIT_CHARS:-$MAX_REPLY_CHARS}"
LOG_FILE="${LARK_CODEX_LOG_FILE:-$BASE_DIR/bridge.log}"
CODEX_MODEL="${LARK_CODEX_MODEL:-gpt-5.2}"
CODEX_BIN="${LARK_CODEX_BIN:-codex}"
CODEX_TASK_TIMEOUT_SECONDS="${LARK_CODEX_TASK_TIMEOUT_SECONDS:-900}"
CODEX_LONG_TASK_TIMEOUT_SECONDS="${LARK_CODEX_LONG_TASK_TIMEOUT_SECONDS:-3600}"
TASK_MODE="${LARK_CODEX_TASK_MODE:-auto-long}"
TERMINAL_RENDER="${LARK_CODEX_TERMINAL_RENDER:-screen}"
IDLE_STATUS_PATCH_SECONDS="${LARK_CODEX_IDLE_STATUS_PATCH_SECONDS:-60}"
ACK_EMOJI="${LARK_CODEX_ACK_EMOJI:-👀}"
ACK_MODE="${LARK_CODEX_ACK_MODE:-reaction}"
ACK_REACTION_EMOJI="${LARK_CODEX_ACK_REACTION_EMOJI:-OK}"
RESULT_FORMAT="${LARK_CODEX_RESULT_FORMAT:-card}"
DIRECTORY_FORMAT="${LARK_CODEX_DIRECTORY_FORMAT:-card}"
OUTPUT_STYLE="${LARK_CODEX_OUTPUT_STYLE:-compact}"
CARD_SCHEMA="${LARK_CODEX_CARD_SCHEMA:-2}"
SYNC_RENDER_DEFAULT="${LARK_CODEX_SYNC_RENDER:-stream}"
ENABLE_MESSAGE_UPDATE_DEFAULT="${LARK_CODEX_ENABLE_MESSAGE_UPDATE:-false}"
STATE_DIR="${LARK_CODEX_STATE_DIR:-$BASE_DIR/state}"
LOCK_DIR="$STATE_DIR/running.lock"
RUNNING_LOCK_PID_FILE="$LOCK_DIR/pid"
TASK_QUEUE_DIR="$STATE_DIR/queue"
SYNC_INTERVAL_SECONDS="${LARK_CODEX_SYNC_INTERVAL_SECONDS:-60}"
SESSION_STREAM_INTERVAL_SECONDS="${LARK_CODEX_SESSION_STREAM_INTERVAL_SECONDS:-8}"
SYNC_MAX_SECONDS="${LARK_CODEX_SYNC_MAX_SECONDS:-3600}"
DIRECTORY_LIMIT="${LARK_CODEX_DIRECTORY_LIMIT:-12}"
CODEX_SESSIONS_ROOT="${LARK_CODEX_SESSIONS_ROOT:-$HOME/.codex/sessions}"
CODEX_STATE_DB="${LARK_CODEX_STATE_DB:-$HOME/.codex/state_5.sqlite}"
LARK_CODEX_DANGEROUS_BYPASS="${LARK_CODEX_DANGEROUS_BYPASS:-false}"

CHATS_DIR="$STATE_DIR/chats"
CHAT_ID=""
CHAT_STATE_DIR=""
SETTINGS_FILE=""
STATUS_FILE=""
TASK_LOG_FILE=""
SESSION_ALIAS_FILE=""
PINNED_SESSIONS_FILE=""
ACTIVE_SESSION_FILE=""
NEW_SESSION_FILE=""
JOBS_DIR=""
LATEST_JOB_FILE=""
RUNNING_CARDS_DIR=""
TERMINAL_BUFFERS_DIR=""
SYNC_FILE=""
SYNC_STOP_FILE=""
SYNC_LOCK_DIR=""
CHAT_WORKDIR=""
CHAT_OUTPUT_LIMIT_CHARS=""
CHAT_DEBUG=""
CHAT_SYNC_RENDER=""
CHAT_ENABLE_MESSAGE_UPDATE=""
SYNC_SCREEN_MODE="false"
SYNC_SCREEN_MESSAGE_ID=""
SYNC_SCREEN_BUFFER_FILE=""
SYNC_SCREEN_MAX_LINES="${LARK_CODEX_SYNC_SCREEN_MAX_LINES:-180}"

if [[ "$OUTPUT_STYLE" != "compact" && "$OUTPUT_STYLE" != "verbose" ]]; then
  OUTPUT_STYLE="compact"
fi
case "$TASK_MODE" in
  auto-long|explicit-long) ;;
  *) TASK_MODE="auto-long" ;;
esac
case "$TERMINAL_RENDER" in
  screen|stream) ;;
  *) TERMINAL_RENDER="screen" ;;
esac
if [[ ! "$DIRECTORY_LIMIT" =~ ^[0-9]+$ ]]; then
  DIRECTORY_LIMIT=12
fi
if [[ ! "$IDLE_STATUS_PATCH_SECONDS" =~ ^[0-9]+$ ]]; then
  IDLE_STATUS_PATCH_SECONDS=60
fi
if [[ ! "$CODEX_TASK_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]]; then
  CODEX_TASK_TIMEOUT_SECONDS=900
fi
if [[ ! "$CODEX_LONG_TASK_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]]; then
  CODEX_LONG_TASK_TIMEOUT_SECONDS=3600
fi
if ((CODEX_LONG_TASK_TIMEOUT_SECONDS < CODEX_TASK_TIMEOUT_SECONDS)); then
  CODEX_LONG_TASK_TIMEOUT_SECONDS="$CODEX_TASK_TIMEOUT_SECONDS"
fi

timestamp() {
  date '+%Y-%m-%dT%H:%M:%S%z'
}

if [[ ! -f "$CRED_FILE" ]]; then
  echo "Missing credentials file: $CRED_FILE" >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$CRED_FILE"

mkdir -p "$(dirname "$LOG_FILE")"
mkdir -p "$STATE_DIR"
mkdir -p "$CHATS_DIR"
mkdir -p "$TASK_QUEUE_DIR"
exec >>"$LOG_FILE" 2>&1

: "${LARKSUITE_CLI_APP_ID:?Missing LARKSUITE_CLI_APP_ID}"
: "${LARKSUITE_CLI_APP_SECRET:?Missing LARKSUITE_CLI_APP_SECRET}"
if [[ -z "$ALLOWED_SENDER" ]]; then
  echo "Missing LARK_CODEX_ALLOWED_SENDER. Set it to the Feishu/Lark open_id allowed to control Codex." >&2
  exit 1
fi
export LARKSUITE_CLI_APP_ID LARKSUITE_CLI_APP_SECRET
export FEISHU_APP_ID="${FEISHU_APP_ID:-$LARKSUITE_CLI_APP_ID}"
export FEISHU_APP_SECRET="${FEISHU_APP_SECRET:-$LARKSUITE_CLI_APP_SECRET}"

refresh_tenant_token() {
  local response token

  response="$(
    jq -n \
      --arg app_id "$LARKSUITE_CLI_APP_ID" \
      --arg app_secret "$LARKSUITE_CLI_APP_SECRET" \
      '{app_id:$app_id,app_secret:$app_secret}' |
      curl -fsS \
        -X POST \
        -H 'Content-Type: application/json' \
        -d @- \
        https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal
  )"

  token="$(jq -r '.tenant_access_token // empty' <<<"$response")"
  if [[ -z "$token" ]]; then
    echo "Could not fetch Feishu tenant_access_token: $(jq -c '{code,msg}' <<<"$response")" >&2
    return 1
  fi

  export LARKSUITE_CLI_TENANT_ACCESS_TOKEN="$token"
}

truncate_reply_text() {
  local text="$1"
  local max="${2:-${CHAT_OUTPUT_LIMIT_CHARS:-$MAX_REPLY_CHARS}}"

  if ((${#text} > max)); then
    printf '%s\n\n[output truncated]' "${text:0:max}"
  else
    printf '%s' "$text"
  fi
}

short_id() {
  local id="$1"
  local first last

  if [[ -z "$id" ]]; then
    return 0
  fi
  if ((${#id} <= 16)); then
    printf '%s' "$id"
    return 0
  fi

  first="${id:0:8}"
  last="${id#${id%????}}"
  printf '%s...%s' "$first" "$last"
}

short_path() {
  local path="${1:-}"

  [[ -n "$path" ]] || return 0
  if [[ "$path" == "$HOME" ]]; then
    path="~"
  elif [[ "$path" == "$HOME/"* ]]; then
    path="~/${path#"$HOME/"}"
  fi
  printf '%s' "$path" | compact_text 48
}

safe_fs_id() {
  local id="$1"

  id="${id//[^A-Za-z0-9._-]/_}"
  [[ -n "$id" ]] || id="_"
  printf '%s' "$id"
}

expand_path() {
  local path="$1"

  if [[ "$path" == "~" ]]; then
    printf '%s' "$HOME"
    return 0
  fi
  if [[ "$path" == "~/"* ]]; then
    printf '%s/%s' "$HOME" "${path#~/}"
    return 0
  fi
  printf '%s' "$path"
}

chat_settings_ensure() {
  local limit sync_render enable_update enable_bool

  [[ -n "$SETTINGS_FILE" ]] || return 1
  [[ -f "$SETTINGS_FILE" ]] && return 0

  limit="$OUTPUT_LIMIT_CHARS_DEFAULT"
  [[ "$limit" =~ ^[0-9]+$ ]] || limit="$MAX_REPLY_CHARS"
  sync_render="$SYNC_RENDER_DEFAULT"
  enable_update="$ENABLE_MESSAGE_UPDATE_DEFAULT"
  enable_bool="false"
  [[ "$enable_update" == "true" ]] && enable_bool="true"

  jq -n \
    --arg workdir "$CODEX_WORKDIR" \
    --argjson output_limit_chars "$limit" \
    --arg sync_render "$sync_render" \
    --argjson debug false \
    --argjson enable_message_update "$enable_bool" \
    '{
      workdir: $workdir,
      output_limit_chars: $output_limit_chars,
      debug: $debug,
      sync_render: $sync_render,
      enable_message_update: $enable_message_update
    }' >"$SETTINGS_FILE"
}

chat_settings_load_into_vars() {
  local workdir limit debug sync_render enable_update

  [[ -f "$SETTINGS_FILE" ]] || return 1
  workdir="$(jq -r '.workdir // empty' "$SETTINGS_FILE" 2>/dev/null || true)"
  limit="$(jq -r '.output_limit_chars // empty' "$SETTINGS_FILE" 2>/dev/null || true)"
  debug="$(jq -r '.debug // false' "$SETTINGS_FILE" 2>/dev/null || true)"
  sync_render="$(jq -r '.sync_render // empty' "$SETTINGS_FILE" 2>/dev/null || true)"
  enable_update="$(jq -r '.enable_message_update // empty' "$SETTINGS_FILE" 2>/dev/null || true)"

  [[ -n "$workdir" ]] || workdir="$CODEX_WORKDIR"
  [[ "$limit" =~ ^[0-9]+$ ]] || limit="$OUTPUT_LIMIT_CHARS_DEFAULT"
  [[ "$debug" == "true" || "$debug" == "false" ]] || debug="false"
  case "$sync_render" in
    stream|screen) ;;
    *) sync_render="$SYNC_RENDER_DEFAULT" ;;
  esac
  [[ "$enable_update" == "true" || "$enable_update" == "false" ]] || enable_update="$ENABLE_MESSAGE_UPDATE_DEFAULT"

  CHAT_WORKDIR="$workdir"
  CHAT_OUTPUT_LIMIT_CHARS="$limit"
  CHAT_DEBUG="$debug"
  CHAT_SYNC_RENDER="$sync_render"
  CHAT_ENABLE_MESSAGE_UPDATE="$enable_update"
}

chat_settings_set() {
  local key="$1"
  local value="$2"
  local tmp

  [[ -f "$SETTINGS_FILE" ]] || chat_settings_ensure
  tmp="$SETTINGS_FILE.$$"
  jq \
    --arg key "$key" \
    --arg value "$value" \
    '
      if $key == "workdir" then .workdir = $value
      elif $key == "sync_render" then
        if $value == "stream" or $value == "screen" then .sync_render = $value else . end
      elif $key == "debug" then .debug = ($value == "true")
      elif $key == "enable_message_update" then .enable_message_update = ($value == "true")
      elif $key == "output_limit_chars" then .output_limit_chars = (try ($value|tonumber) catch .output_limit_chars)
      else . end
    ' "$SETTINGS_FILE" >"$tmp"
  mv "$tmp" "$SETTINGS_FILE"
  chat_settings_load_into_vars
}

chat_context_load() {
  local raw_chat_id="$1"
  local safe_chat_id

  safe_chat_id="$(safe_fs_id "$raw_chat_id")"
  CHAT_ID="$raw_chat_id"
  CHAT_STATE_DIR="$CHATS_DIR/$safe_chat_id"
  SETTINGS_FILE="$CHAT_STATE_DIR/settings.json"
  STATUS_FILE="$CHAT_STATE_DIR/status.json"
  TASK_LOG_FILE="$CHAT_STATE_DIR/current.log"
  SESSION_ALIAS_FILE="$CHAT_STATE_DIR/session_aliases.tsv"
  PINNED_SESSIONS_FILE="$CHAT_STATE_DIR/pinned_sessions.txt"
  ACTIVE_SESSION_FILE="$CHAT_STATE_DIR/active_session.json"
  NEW_SESSION_FILE="$CHAT_STATE_DIR/new_session_pending.json"
  JOBS_DIR="$CHAT_STATE_DIR/jobs"
  LATEST_JOB_FILE="$CHAT_STATE_DIR/latest_job.json"
  RUNNING_CARDS_DIR="$CHAT_STATE_DIR/running_cards"
  TERMINAL_BUFFERS_DIR="$CHAT_STATE_DIR/terminal_buffers"
  SYNC_FILE="$CHAT_STATE_DIR/sync.json"
  SYNC_STOP_FILE="$CHAT_STATE_DIR/sync.stop"
  SYNC_LOCK_DIR="$CHAT_STATE_DIR/sync.lock"

  mkdir -p "$CHAT_STATE_DIR" "$JOBS_DIR" "$RUNNING_CARDS_DIR" "$TERMINAL_BUFFERS_DIR"
  chat_settings_ensure
  chat_settings_load_into_vars
}

trim_ws() {
  perl -CS -Mutf8 -0pe 's/^\s+|\s+$//g'
}

strip_group_mentions() {
  # Best-effort: remove common mention tags or placeholders from group chats.
  # Keep the remaining text as terminal input.
  sed -E \
    -e 's/<at[^>]*><\/at>//g' \
    -e 's/<at[^>]*>[^<]*<\/at>//g' \
    -e 's/@_user_[A-Za-z0-9]+//g'
}

extract_text_from_content() {
  local content="$1"
  local text=""

  if [[ -z "$content" ]]; then
    return 1
  fi

  if [[ "$content" == "{"*"}" ]]; then
    text="$(jq -r '.text // empty' <<<"$content" 2>/dev/null || true)"
    if [[ -n "$text" ]]; then
      printf '%s' "$text"
      return 0
    fi
  fi

  printf '%s' "$content"
}

normalize_prompt() {
  local prompt="$1"

  prompt="$(printf '%s' "$prompt" | strip_group_mentions | trim_ws)"

  if [[ "$prompt" == "$COMMAND_PREFIX" ]]; then
    prompt=""
  elif [[ "$prompt" == "$COMMAND_PREFIX "* ]]; then
    prompt="${prompt#"$COMMAND_PREFIX "}"
  elif [[ "$prompt" == "$COMMAND_PREFIX"$'\u3000'* ]]; then
    prompt="${prompt#"$COMMAND_PREFIX"$'\u3000'}"
  fi

  prompt="$(printf '%s' "$prompt" | trim_ws)"
  printf '%s' "$prompt"
}

reply_text() {
  local message_id="$1"
  local text="$2"

  text="$(truncate_reply_text "$text")"

  refresh_tenant_token
  lark-cli im +messages-reply \
    --message-id "$message_id" \
    --text "$text" \
    --as bot >/dev/null </dev/null
}

reply() {
  reply_text "$@"
}

reply_card() {
  local message_id="$1"
  local card_json="$2"

  refresh_tenant_token
  lark-cli im +messages-reply \
    --message-id "$message_id" \
    --msg-type interactive \
    --content "$card_json" \
    --as bot >/dev/null </dev/null
}

reply_card_capture_message_id() {
  local message_id="$1"
  local card_json="$2"
  local response new_id

  refresh_tenant_token
  response="$(
    lark-cli im +messages-reply \
      --message-id "$message_id" \
      --msg-type interactive \
      --content "$card_json" \
      --as bot </dev/null
  )"

  new_id="$(jq -r '.data.message_id // .data.message.message_id // empty' <<<"$response" 2>/dev/null || true)"
  [[ -n "$new_id" ]] || return 1
  printf '%s' "$new_id"
}

update_interactive_message() {
  local target_message_id="$1"
  local card_json="$2"

  refresh_tenant_token
  # Prefer PATCH; fall back to PUT for older tenants/endpoints.
  lark-cli api patch "/im/v1/messages/$target_message_id" \
    --data "$(jq -n --arg msg_type "interactive" --arg content "$card_json" '{msg_type:$msg_type, content:$content}')" \
    --as bot >/dev/null </dev/null ||
    lark-cli api put "/im/v1/messages/$target_message_id" \
      --data "$(jq -n --arg msg_type "interactive" --arg content "$card_json" '{msg_type:$msg_type, content:$content}')" \
      --as bot >/dev/null </dev/null
}

add_reaction() {
  local message_id="$1"
  local emoji_type="${2:-$ACK_REACTION_EMOJI}"

  refresh_tenant_token
  lark-cli im reactions create \
    --params "$(jq -n --arg message_id "$message_id" '{message_id:$message_id}')" \
    --data "$(jq -n --arg emoji_type "$emoji_type" '{reaction_type:{emoji_type:$emoji_type}}')" \
    --as bot >/dev/null </dev/null
}

ack_message() {
  local message_id="$1"

  case "$ACK_MODE" in
    text)
      reply_text "$message_id" "$ACK_EMOJI"
      ;;
    both)
      add_reaction "$message_id" "$ACK_REACTION_EMOJI" || true
      reply_text "$message_id" "$ACK_EMOJI"
      ;;
    reaction|*)
      add_reaction "$message_id" "$ACK_REACTION_EMOJI" || true
      ;;
  esac
}

final_reply_text() {
  local answer="$1"

  printf '✅ 完成\n\n%s' "$answer"
}

failed_reply_text() {
  local detail="${1:-Codex failed while handling this request.}"

  printf '❌ 失败\n\n%s\n\n发送 logs 查看最近日志。' "$detail"
}

card_json_v1() {
  local title="$1"
  local template="$2"
  local body="$3"
  local footer="${4:-发送 status / logs 查看桥接状态}"

  body="$(truncate_reply_text "$body" "$MAX_REPLY_CHARS")"
  jq -n \
    --arg title "$title" \
    --arg template "$template" \
    --arg body "$body" \
    --arg footer "$footer" \
    '{
      config: {wide_screen_mode: true},
      header: {
        template: $template,
        title: {tag: "plain_text", content: $title}
      },
      elements: [
        {tag: "div", text: {tag: "lark_md", content: $body}},
        {tag: "hr"},
        {tag: "note", elements: [{tag: "plain_text", content: $footer}]}
      ]
    }'
}

card_json_v2() {
  local title="$1"
  local template="$2"
  local body="$3"
  local detail="${4:-}"

  body="$(truncate_reply_text "$body")"
  detail="$(truncate_reply_text "$detail")"

  jq -n \
    --arg title "$title" \
    --arg template "$template" \
    --arg body "$body" \
    --arg detail "$detail" \
    '{
      schema: "2.0",
      config: {
        wide_screen_mode: true,
        enable_forward: false,
        update_multi: true
      },
      header: {
        template: $template,
        title: {tag: "plain_text", content: $title}
      },
      body: {
        elements:
          (
            [
              {tag: "markdown", content: $body}
            ]
            +
            (if ($detail | length) > 0 then
              [
                {
                  tag: "collapsible_panel",
                  expanded: false,
                  header: {
                    title: {tag: "plain_text", content: "详情"},
                    vertical_align: "center",
                    icon: {
                      tag: "standard_icon",
                      token: "down-small-ccm_outlined",
                      color: "",
                      size: "16px 16px"
                    },
                    icon_position: "right",
                    icon_expanded_angle: -180
                  },
                  elements: [
                    {tag: "markdown", content: $detail}
                  ]
                }
              ]
            else [] end)
          )
      }
    }'
}

card_json() {
  local title="$1"
  local template="$2"
  local body="$3"
  local detail="${4:-发送 status / logs 查看桥接状态}"

  if [[ "$CARD_SCHEMA" == "2" || "$CARD_SCHEMA" == "2.0" ]]; then
    card_json_v2 "$title" "$template" "$body" "$detail"
  else
    card_json_v1 "$title" "$template" "$body" "$detail"
  fi
}

result_card_json() {
  local status="$1"
  local answer="$2"
  local task_id="$3"
  local prompt="$4"
  local session_id="${5:-}"
  local elapsed_seconds="${6:-0}"
  local title template target body number detail workdir

  if [[ "$status" == "success" ]]; then
    title="✅ 完成"
    template="green"
  elif [[ "$status" == "paused" ]]; then
    title="PAUSED Codex"
    template="orange"
  else
    title="❌ 失败"
    template="red"
  fi

  if [[ -n "$session_id" ]]; then
    number="$(session_alias_number "$session_id" || true)"
    if [[ -n "$number" ]]; then
      target="$(session_title "$session_id") (#$number)"
    else
      target="$(session_title "$session_id") ($(short_id "$session_id"))"
    fi
  else
    target="新任务"
  fi

  prompt="$(printf '%s' "$prompt" | compact_text 180)"
  body="$(printf '%s' "$answer")"

  detail=$(
    printf '**任务**：%s\n' "$prompt"
    printf '**目标**：%s\n' "$target"
    if [[ -z "$session_id" ]]; then
      workdir="${CHAT_WORKDIR:-$CODEX_WORKDIR}"
      [[ -n "$workdir" ]] && printf '**workdir**：%s\n' "$workdir"
    fi
    printf '**耗时**：%ss\n' "$elapsed_seconds"
    printf '**队列**：%s\n' "$(queue_count)"
    printf '**task_id**：%s\n' "$task_id"
    if [[ "$CHAT_DEBUG" == "true" || "$OUTPUT_STYLE" == "verbose" ]]; then
      printf '\n命令：logs / status / 目录 / 当前会话\n'
    fi
  )

  card_json "$title" "$template" "$body" "$detail"
}

reply_result() {
  local message_id="$1"
  local status="$2"
  local answer="$3"
  local task_id="$4"
  local prompt="$5"
  local session_id="${6:-}"
  local elapsed_seconds="${7:-0}"
  local fallback card

  if [[ "$status" == "success" ]]; then
    fallback="$(final_reply_text "$answer")"
  elif [[ "$status" == "paused" ]]; then
    fallback="$(printf 'PAUSED\n\n%s\n\n发送 continue 继续。' "$answer")"
  else
    fallback="$(failed_reply_text "$answer")"
  fi

  if [[ -f "$(terminal_card_file_path "$message_id")" ]]; then
    if [[ "$status" == "success" ]]; then
      terminal_update_card "$message_id" "DONE" "$answer" "$task_id" "$prompt" "$session_id" "$elapsed_seconds" "" "" "true"
      add_reaction "$message_id" "DONE" || true
      rm -f "$(terminal_card_file_path "$message_id")"
    elif [[ "$status" == "paused" ]]; then
      terminal_update_card "$message_id" "PAUSED" "$answer" "$task_id" "$prompt" "$session_id" "$elapsed_seconds" "" "send: continue" "true"
    else
      terminal_update_card "$message_id" "FAILED" "$answer" "$task_id" "$prompt" "$session_id" "$elapsed_seconds" "" "send: logs" "true"
      rm -f "$(terminal_card_file_path "$message_id")"
    fi
    return
  fi

  if [[ "$RESULT_FORMAT" == "card" ]]; then
    card="$(result_card_json "$status" "$answer" "$task_id" "$prompt" "$session_id" "$elapsed_seconds")"
    reply_card "$message_id" "$card" || reply_text "$message_id" "$fallback"
  else
    reply_text "$message_id" "$fallback"
  fi
}

reply_notice() {
  local message_id="$1"
  local title="$2"
  local template="$3"
  local body="$4"
  local detail="${5:-}"
  local fallback="${6:-$body}"
  local card

  card="$(card_json "$title" "$template" "$body" "$detail")"
  reply_card "$message_id" "$card" || reply_text "$message_id" "$fallback"
}

terminal_card_file_path() {
  local source_message_id="$1"
  printf '%s/%s.json' "$RUNNING_CARDS_DIR" "$(safe_fs_id "$source_message_id")"
}

terminal_buffer_file_path() {
  local source_message_id="$1"
  printf '%s/%s.buffer' "$TERMINAL_BUFFERS_DIR" "$(safe_fs_id "$source_message_id")"
}

terminal_stop_file_path() {
  local source_message_id="$1"
  printf '%s/%s.stop' "$TERMINAL_BUFFERS_DIR" "$(safe_fs_id "$source_message_id")"
}

terminal_card_id() {
  local source_message_id="$1"
  local file

  file="$(terminal_card_file_path "$source_message_id")"
  [[ -f "$file" ]] || return 1
  jq -r '.card_message_id // empty' "$file" 2>/dev/null | head -n 1
}

terminal_card_degraded() {
  local source_message_id="$1"
  local file

  file="$(terminal_card_file_path "$source_message_id")"
  [[ -f "$file" ]] || return 1
  [[ "$(jq -r '.degraded // false' "$file" 2>/dev/null || true)" == "true" ]]
}

terminal_store_card() {
  local source_message_id="$1"
  local card_message_id="${2:-}"
  local state="${3:-RUNNING}"
  local degraded="${4:-false}"
  local file

  file="$(terminal_card_file_path "$source_message_id")"
  jq -n \
    --arg source_message_id "$source_message_id" \
    --arg card_message_id "$card_message_id" \
    --arg state "$state" \
    --arg updated_at "$(timestamp)" \
    --arg degraded "$degraded" \
    '{
      source_message_id:$source_message_id,
      card_message_id:$card_message_id,
      state:$state,
      degraded:($degraded == "true"),
      updated_at:$updated_at
    }' >"$file"
}

terminal_update_card_state() {
  local source_message_id="$1"
  local state="$2"
  local degraded="${3:-}"
  local file tmp

  file="$(terminal_card_file_path "$source_message_id")"
  [[ -f "$file" ]] || return 0
  tmp="$file.$$"
  jq \
    --arg state "$state" \
    --arg degraded "$degraded" \
    --arg updated_at "$(timestamp)" \
    '.state = $state
      | .updated_at = $updated_at
      | if $degraded != "" then .degraded = ($degraded == "true") else . end' \
    "$file" >"$tmp"
  mv "$tmp" "$file"
}

terminal_state_template() {
  case "$1" in
    DONE) printf 'green' ;;
    FAILED) printf 'red' ;;
    PAUSED) printf 'orange' ;;
    QUEUED) printf 'yellow' ;;
    *) printf 'blue' ;;
  esac
}

terminal_state_title() {
  local state="$1"

  case "$state" in
    DONE) printf 'DONE Codex' ;;
    FAILED) printf 'FAILED Codex' ;;
    PAUSED) printf 'PAUSED Codex' ;;
    QUEUED) printf 'QUEUED Codex' ;;
    STARTING) printf 'STARTING Codex' ;;
    *) printf 'RUNNING Codex' ;;
  esac
}

terminal_session_label() {
  local session_id="${1:-}"
  local number title

  if [[ -z "$session_id" ]]; then
    printf 'new'
    return
  fi
  number="$(session_alias_number "$session_id" || true)"
  title="$(session_title "$session_id")"
  if [[ -n "$number" ]]; then
    printf '#%s %s' "$number" "$title"
  else
    printf '%s' "$(short_id "$session_id")"
  fi
}

terminal_safe_fence_text() {
  perl -CS -Mutf8 -0pe 's/```/`\x{200b}``/g'
}

terminal_card_json() {
  local state="$1"
  local output="$2"
  local task_id="${3:-}"
  local prompt="${4:-}"
  local session_id="${5:-}"
  local elapsed_seconds="${6:-0}"
  local job_id="${7:-}"
  local error_detail="${8:-}"
  local title template body detail session_label cwd queue prompt_short output_text

  [[ "$elapsed_seconds" =~ ^[0-9]+$ ]] || elapsed_seconds=0
  title="$(terminal_state_title "$state")"
  template="$(terminal_state_template "$state")"
  session_label="$(terminal_session_label "$session_id")"
  cwd="$(short_path "${CHAT_WORKDIR:-$CODEX_WORKDIR}")"
  queue="$(queue_count)"
  prompt_short="$(printf '%s' "$prompt" | compact_text 260)"
  output_text="$(printf '%s' "$output" | terminal_safe_fence_text)"
  if [[ -z "$output_text" ]]; then
    case "$state" in
      QUEUED) output_text="queued: $prompt_short" ;;
      PAUSED) output_text="task paused. send: continue" ;;
      DONE) output_text="done." ;;
      FAILED) output_text="task failed. send: logs" ;;
      *) output_text="working..." ;;
    esac
  fi

  body=$(
    printf '```text\n%s\n```\n\n' "$output_text"
    printf '`%s` elapsed %ss | queue %s | session %s | cwd %s\n' \
      "$state" "$elapsed_seconds" "$queue" "$session_label" "$cwd"
  )

  detail=$(
    [[ -n "$prompt_short" ]] && printf '**prompt**：%s\n' "$prompt_short"
    [[ -n "$task_id" ]] && printf '**task_id**：%s\n' "$task_id"
    [[ -n "$job_id" ]] && printf '**job_id**：%s\n' "$job_id"
    [[ -n "$session_id" ]] && printf '**session_id**：%s\n' "$session_id"
    printf '**workdir**：%s\n' "${CHAT_WORKDIR:-$CODEX_WORKDIR}"
    printf '**queue**：%s\n' "$queue"
    if [[ -n "$error_detail" ]]; then
      printf '\n%s\n' "$error_detail"
    fi
    printf '\ncommands: sessions / current / attach N / detach / continue / task / queue / logs\n'
  )

  card_json "$title" "$template" "$body" "$detail"
}

terminal_plain_text() {
  local state="$1"
  local output="$2"

  printf '%s\n\n%s' "$state" "$output"
}

terminal_create_card() {
  local source_message_id="$1"
  local state="$2"
  local output="$3"
  local task_id="${4:-}"
  local prompt="${5:-}"
  local session_id="${6:-}"
  local elapsed_seconds="${7:-0}"
  local job_id="${8:-}"
  local error_detail="${9:-}"
  local card new_id buffer_file

  buffer_file="$(terminal_buffer_file_path "$source_message_id")"
  : >"$buffer_file" 2>/dev/null || true
  card="$(terminal_card_json "$state" "$output" "$task_id" "$prompt" "$session_id" "$elapsed_seconds" "$job_id" "$error_detail")"

  if [[ "$TERMINAL_RENDER" == "screen" ]]; then
    if new_id="$(reply_card_capture_message_id "$source_message_id" "$card" 2>/dev/null)"; then
      terminal_store_card "$source_message_id" "$new_id" "$state" "false"
      return 0
    fi
  fi

  terminal_store_card "$source_message_id" "" "$state" "true"
  reply_card "$source_message_id" "$card" || reply_text "$source_message_id" "$(terminal_plain_text "$state" "$output")"
}

terminal_update_card() {
  local source_message_id="$1"
  local state="$2"
  local output="$3"
  local task_id="${4:-}"
  local prompt="${5:-}"
  local session_id="${6:-}"
  local elapsed_seconds="${7:-0}"
  local job_id="${8:-}"
  local error_detail="${9:-}"
  local stream_on_degrade="${10:-true}"
  local card card_id

  if [[ ! -f "$(terminal_card_file_path "$source_message_id")" ]]; then
    terminal_create_card "$source_message_id" "$state" "$output" "$task_id" "$prompt" "$session_id" "$elapsed_seconds" "$job_id" "$error_detail"
    return
  fi

  card="$(terminal_card_json "$state" "$output" "$task_id" "$prompt" "$session_id" "$elapsed_seconds" "$job_id" "$error_detail")"
  card_id="$(terminal_card_id "$source_message_id" || true)"
  if [[ "$TERMINAL_RENDER" == "screen" && -n "$card_id" ]] && ! terminal_card_degraded "$source_message_id"; then
    if update_interactive_message "$card_id" "$card"; then
      terminal_update_card_state "$source_message_id" "$state"
      return 0
    fi
    terminal_update_card_state "$source_message_id" "$state" "true"
  else
    terminal_update_card_state "$source_message_id" "$state"
  fi

  if [[ "$stream_on_degrade" == "true" ]]; then
    reply_card "$source_message_id" "$card" || reply_text "$source_message_id" "$(terminal_plain_text "$state" "$output")"
  fi
}

terminal_append_output() {
  local source_message_id="$1"
  local delta="$2"
  local buffer_file

  [[ -n "$delta" ]] || return 0
  buffer_file="$(terminal_buffer_file_path "$source_message_id")"
  {
    [[ -f "$buffer_file" ]] && cat "$buffer_file" || true
    printf '%s\n' "$delta"
  } | tail -n "${SYNC_SCREEN_MAX_LINES:-180}" >"$buffer_file.$$"
  mv "$buffer_file.$$" "$buffer_file"
}

terminal_buffer_text() {
  local source_message_id="$1"
  local fallback="${2:-working...}"
  local buffer_file

  buffer_file="$(terminal_buffer_file_path "$source_message_id")"
  if [[ -s "$buffer_file" ]]; then
    cat "$buffer_file"
  else
    printf '%s' "$fallback"
  fi
}

session_line_count() {
  local session_id="$1"
  local file

  file="$(find_session_file "$session_id")"
  [[ -n "$file" && -f "$file" ]] || { printf '0'; return; }
  wc -l <"$file" | tr -d ' '
}

terminal_progress_loop() {
  local source_message_id="$1"
  local task_id="$2"
  local prompt="$3"
  local session_id="${4:-}"
  local started_ms="$5"
  local started_epoch="$6"
  local job_id="${7:-}"
  local codex_pid="$8"
  local stop_file="$9"
  local initial_lines="${10:-0}"
  local last_lines current_lines first_line delta output now elapsed last_patch discovered_session

  [[ "$initial_lines" =~ ^[0-9]+$ ]] || initial_lines=0
  last_lines="$initial_lines"
  last_patch="$(date '+%s')"

  while kill -0 "$codex_pid" 2>/dev/null; do
    [[ ! -f "$stop_file" ]] || break
    now="$(date '+%s')"
    elapsed=$((now - started_epoch))

    if [[ -z "$session_id" ]]; then
      discovered_session="$(latest_created_session_id_since "$started_ms" "${CHAT_WORKDIR:-$CODEX_WORKDIR}" || true)"
      if [[ -n "$discovered_session" ]]; then
        session_id="$discovered_session"
        last_lines=0
        [[ -n "$job_id" ]] && job_update_state "$job_id" "running" "$task_id" "$source_message_id" "$prompt" "$session_id" "" ""
      fi
    fi

    if [[ -n "$session_id" ]]; then
      current_lines="$(session_line_count "$session_id")"
      if [[ "$current_lines" =~ ^[0-9]+$ && "$last_lines" =~ ^[0-9]+$ && "$current_lines" -gt "$last_lines" ]]; then
        first_line=$((last_lines + 1))
        delta="$(session_stream_text "$session_id" "$first_line" 36 false)"
        if [[ -n "$delta" ]]; then
          terminal_append_output "$source_message_id" "$delta"
          output="$(terminal_buffer_text "$source_message_id")"
          terminal_update_card "$source_message_id" "RUNNING" "$output" "$task_id" "$prompt" "$session_id" "$elapsed" "$job_id" "" "true" || true
          last_patch="$now"
        fi
        last_lines="$current_lines"
      fi
    fi

    if ((IDLE_STATUS_PATCH_SECONDS > 0 && now - last_patch >= IDLE_STATUS_PATCH_SECONDS)); then
      output="$(terminal_buffer_text "$source_message_id" "working...")"
      terminal_update_card "$source_message_id" "RUNNING" "$output" "$task_id" "$prompt" "$session_id" "$elapsed" "$job_id" "" "false" || true
      last_patch="$now"
    fi

    sleep 5
  done
}

set_status() {
  local state="$1"
  local task_id="$2"
  local message_id="$3"
  local prompt="$4"
  local detail="${5:-}"

  jq -n \
    --arg state "$state" \
    --arg task_id "$task_id" \
    --arg message_id "$message_id" \
    --arg prompt "$prompt" \
    --arg detail "$detail" \
    --arg updated_at "$(timestamp)" \
    '{state:$state,task_id:$task_id,message_id:$message_id,prompt:$prompt,detail:$detail,updated_at:$updated_at}' \
    >"$STATUS_FILE"
}

job_file_path() {
  local job_id="$1"
  printf '%s/%s.json' "$JOBS_DIR" "$(safe_fs_id "$job_id")"
}

job_marker_path() {
  local job_id="$1"
  printf '%s/%s.marker' "$JOBS_DIR" "$(safe_fs_id "$job_id")"
}

latest_job_id() {
  [[ -f "$LATEST_JOB_FILE" ]] || return 1
  jq -r '.job_id // empty' "$LATEST_JOB_FILE" 2>/dev/null | head -n 1
}

resolve_job_ref() {
  local ref="${1:-}"
  local job_id

  if [[ -z "$ref" || "$ref" == "latest" || "$ref" == "最近" ]]; then
    job_id="$(latest_job_id || true)"
  else
    job_id="${ref#\#}"
  fi

  [[ -n "$job_id" && -f "$(job_file_path "$job_id")" ]] || return 1
  printf '%s' "$job_id"
}

create_long_job() {
  local message_id="$1"
  local prompt="$2"
  local session_id="${3:-}"
  local timeout_seconds="${4:-$CODEX_LONG_TASK_TIMEOUT_SECONDS}"
  local reply_mode="${5:-long}"
  local job_id job_file marker

  job_id="job-$(date '+%Y%m%d%H%M%S')-$message_id"
  job_id="$(safe_fs_id "$job_id")"
  job_file="$(job_file_path "$job_id")"
  marker="$(job_marker_path "$job_id")"
  : >"$marker"

  jq -n \
    --arg job_id "$job_id" \
    --arg state "queued" \
    --arg chat_id "${CHAT_ID:-unknown}" \
    --arg message_id "$message_id" \
    --arg original_prompt "$prompt" \
    --arg prompt "$prompt" \
    --arg session_id "$session_id" \
    --arg reply_mode "$reply_mode" \
    --arg workdir "${CHAT_WORKDIR:-$CODEX_WORKDIR}" \
    --arg created_at "$(timestamp)" \
    --arg updated_at "$(timestamp)" \
    --argjson timeout_seconds "$timeout_seconds" \
    '{
      job_id:$job_id,
      state:$state,
      chat_id:$chat_id,
      message_id:$message_id,
      original_prompt:$original_prompt,
      prompt:$prompt,
      session_id:$session_id,
      reply_mode:$reply_mode,
      workdir:$workdir,
      timeout_seconds:$timeout_seconds,
      attempts:0,
      artifacts:[],
      created_at:$created_at,
      updated_at:$updated_at
    }' >"$job_file"

  jq -n --arg job_id "$job_id" --arg updated_at "$(timestamp)" \
    '{job_id:$job_id,updated_at:$updated_at}' >"$LATEST_JOB_FILE"
  printf '%s' "$job_id"
}

job_update_state() {
  local job_id="$1"
  local state="$2"
  local task_id="${3:-}"
  local message_id="${4:-}"
  local prompt="${5:-}"
  local session_id="${6:-}"
  local elapsed_seconds="${7:-}"
  local last_error="${8:-}"
  local job_file tmp

  job_file="$(job_file_path "$job_id")"
  [[ -f "$job_file" ]] || return 0
  tmp="$job_file.$$"
  jq \
    --arg state "$state" \
    --arg task_id "$task_id" \
    --arg message_id "$message_id" \
    --arg prompt "$prompt" \
    --arg session_id "$session_id" \
    --arg elapsed_seconds "$elapsed_seconds" \
    --arg last_error "$last_error" \
    --arg updated_at "$(timestamp)" \
    '
      (.state // "") as $old_state
      |
      .state = $state
      | .updated_at = $updated_at
      | if $task_id != "" then .task_id = $task_id else . end
      | if $message_id != "" then .message_id = $message_id else . end
      | if $prompt != "" then .prompt = $prompt else . end
      | if $session_id != "" then .session_id = $session_id else . end
      | if $elapsed_seconds != "" then .elapsed_seconds = ($elapsed_seconds|tonumber) else . end
      | if $last_error != "" then .last_error = $last_error else . end
      | if $state == "running" and $old_state != "running" then .attempts = ((.attempts // 0) + 1) else . end
    ' "$job_file" >"$tmp"
  mv "$tmp" "$job_file"
  jq -n --arg job_id "$job_id" --arg updated_at "$(timestamp)" \
    '{job_id:$job_id,updated_at:$updated_at}' >"$LATEST_JOB_FILE"
}

job_artifacts_json() {
  local job_id="$1"
  local job_file marker workdir
  local dir

  job_file="$(job_file_path "$job_id")"
  [[ -f "$job_file" ]] || { printf '[]'; return; }
  marker="$(job_marker_path "$job_id")"
  [[ -f "$marker" ]] || marker="$job_file"
  workdir="$(jq -r '.workdir // empty' "$job_file" 2>/dev/null || true)"
  [[ -n "$workdir" ]] || workdir="${CHAT_WORKDIR:-$CODEX_WORKDIR}"

  {
    for dir in "$workdir/output" "$workdir/outputs" "$workdir/artifacts" "$workdir/tmp"; do
      [[ -d "$dir" ]] || continue
      find "$dir" -type f -newer "$marker" 2>/dev/null
    done
  } |
    awk '!seen[$0]++' |
    head -n 20 |
    jq -R -s 'split("\n") | map(select(length > 0))'
}

job_refresh_artifacts() {
  local job_id="$1"
  local job_file tmp artifacts

  job_file="$(job_file_path "$job_id")"
  [[ -f "$job_file" ]] || return 0
  artifacts="$(job_artifacts_json "$job_id")"
  tmp="$job_file.$$"
  jq --argjson artifacts "$artifacts" '.artifacts = $artifacts' "$job_file" >"$tmp"
  mv "$tmp" "$job_file"
}

job_artifacts_text() {
  local job_id="$1"
  local job_file

  job_file="$(job_file_path "$job_id")"
  [[ -f "$job_file" ]] || return 0
  job_refresh_artifacts "$job_id" || true
  if ! jq -e '(.artifacts // []) | length > 0' "$job_file" >/dev/null 2>&1; then
    printf '暂无记录。'
    return
  fi
  jq -r '(.artifacts // [])[] | "- " + .' "$job_file"
}

job_summary_text() {
  local job_id="${1:-}"
  local job_file state prompt created updated timeout attempts session_id title artifacts last_error

  job_id="$(resolve_job_ref "$job_id" || true)"
  if [[ -z "$job_id" ]]; then
    printf '还没有长任务记录。发送：长任务 <内容>'
    return
  fi

  job_file="$(job_file_path "$job_id")"
  job_refresh_artifacts "$job_id" || true
  state="$(jq -r '.state // "unknown"' "$job_file")"
  prompt="$(jq -r '.original_prompt // .prompt // ""' "$job_file" | compact_text 260)"
  created="$(jq -r '.created_at // ""' "$job_file")"
  updated="$(jq -r '.updated_at // ""' "$job_file")"
  timeout="$(jq -r '.timeout_seconds // ""' "$job_file")"
  attempts="$(jq -r '.attempts // 0' "$job_file")"
  session_id="$(jq -r '.session_id // empty' "$job_file")"
  last_error="$(jq -r '.last_error // empty' "$job_file" | compact_text 260)"
  artifacts="$(job_artifacts_text "$job_id")"

  printf '长任务\n'
  printf '状态: %s\n' "$state"
  printf 'ID: %s\n' "$job_id"
  [[ -n "$created" ]] && printf '创建: %s\n' "$created"
  [[ -n "$updated" ]] && printf '更新: %s\n' "$updated"
  [[ -n "$timeout" ]] && printf '超时: %ss\n' "$timeout"
  printf '尝试: %s\n' "$attempts"
  if [[ -n "$session_id" ]]; then
    title="$(session_title "$session_id")"
    printf '会话: %s (%s)\n' "$title" "$(short_id "$session_id")"
  fi
  printf '\n任务:\n%s\n\n' "$prompt"
  [[ -n "$last_error" ]] && printf '失败原因:\n%s\n\n' "$last_error"
  printf '产物:\n%s\n\n' "$artifacts"
  case "$state" in
    failed|timeout|paused|queued)
      printf '下一步: 发送 继续任务'
      ;;
    running)
      printf '下一步: 等待完成，或发送 status / logs 查看。'
      ;;
    completed)
      printf '下一步: 如需继续迭代，发送 长任务 <新需求>。'
      ;;
  esac
}

jobs_list_text() {
  local file state updated prompt session_id title job_id count

  count=0
  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    count=$((count + 1))
    job_id="$(jq -r '.job_id // empty' "$file" 2>/dev/null || true)"
    state="$(jq -r '.state // "unknown"' "$file" 2>/dev/null || true)"
    updated="$(jq -r '.updated_at // ""' "$file" 2>/dev/null || true)"
    prompt="$(jq -r '.original_prompt // .prompt // ""' "$file" 2>/dev/null | compact_text 120)"
    session_id="$(jq -r '.session_id // empty' "$file" 2>/dev/null || true)"
    title=""
    [[ -n "$session_id" ]] && title="$(session_title "$session_id")"
    printf '[%s] %s  %s\n' "$count" "$state" "$updated"
    [[ -n "$title" ]] && printf 'session: %s\n' "$title"
    printf '%s\n' "$prompt"
    [[ -n "$job_id" ]] && printf 'id: %s\n' "$job_id"
    printf '\n'
  done < <(find "$JOBS_DIR" -type f -name '*.json' 2>/dev/null | sort | tail -n 8)

  if ((count == 0)); then
    printf 'no tasks yet. send a normal message to start one.'
  fi
}

job_continue_prompt() {
  local job_id="$1"
  local job_file original artifacts logs

  job_file="$(job_file_path "$job_id")"
  [[ -f "$job_file" ]] || return 1
  original="$(jq -r '.original_prompt // .prompt // ""' "$job_file")"
  artifacts="$(job_artifacts_text "$job_id")"
  logs="$(recent_logs_text | compact_text 3000)"

  cat <<EOF
继续执行这个长任务。不要重做已经完成的部分；优先复用已生成的产物，从未完成的下一步开始。

原始任务：
$original

已记录产物：
$artifacts

最近日志摘要：
$logs

请继续完成剩余步骤，并在最终回答里简洁说明已完成内容、产物路径、还有没有未完成项。
EOF
}

fallback_continue_prompt() {
  local previous_prompt logs

  previous_prompt=""
  if [[ -f "$STATUS_FILE" ]]; then
    previous_prompt="$(jq -r '.prompt // empty' "$STATUS_FILE" 2>/dev/null || true)"
  fi
  logs="$(recent_logs_text | compact_text 3000)"

  cat <<EOF
继续执行当前会话里未完成的任务。不要重做已经完成的部分；优先从最近失败或中断的位置继续。

上一条任务：
${previous_prompt:-继续做任务}

最近日志摘要：
$logs

请继续完成剩余步骤，并在最终回答里简洁说明已完成内容、产物路径、还有没有未完成项。
EOF
}

long_task_failure_text() {
  local job_id="$1"
  local elapsed_seconds="${2:-0}"
  local reason="${3:-长任务失败。}"
  local summary artifacts

  artifacts="$(job_artifacts_text "$job_id")"
  summary="$(job_summary_text "$job_id")"
  printf '长任务未完成。\n\n%s\n\n耗时：%ss\n\n已记录产物：\n%s\n\n发送 继续任务 可从这个任务继续。' \
    "$reason" "$elapsed_seconds" "$artifacts"
  if [[ "$CHAT_DEBUG" == "true" || "$OUTPUT_STYLE" == "verbose" ]]; then
    printf '\n\n%s' "$summary"
  fi
}

reply_job_status() {
  local message_id="$1"
  local job_ref="${2:-}"
  local body

  body="$(job_summary_text "$job_ref")"
  reply_notice "$message_id" "长任务" "blue" "$body" "命令：长任务 <内容> / 继续任务 / logs" "$body"
}

queue_count() {
  find "$TASK_QUEUE_DIR" -type f -name '*.json' 2>/dev/null | wc -l | tr -d ' '
}

mtime_epoch() {
  local path="$1"
  stat -f '%m' "$path" 2>/dev/null || stat -c '%Y' "$path" 2>/dev/null || echo 0
}

recover_stale_running_lock() {
  local now mtime age stale_after pid lock_contents

  [[ -d "$LOCK_DIR" ]] || return 0

  if [[ -f "$RUNNING_LOCK_PID_FILE" ]]; then
    pid=""
    read -r pid <"$RUNNING_LOCK_PID_FILE" 2>/dev/null || true
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi

  now="$(date '+%s')"
  mtime="$(mtime_epoch "$LOCK_DIR")"
  [[ "$mtime" =~ ^[0-9]+$ ]] || mtime=0
  ((mtime > 0)) || return 0

  stale_after=$((CODEX_TASK_TIMEOUT_SECONDS + 120))
  if ((CODEX_LONG_TASK_TIMEOUT_SECONDS + 120 > stale_after)); then
    stale_after=$((CODEX_LONG_TASK_TIMEOUT_SECONDS + 120))
  fi
  age=$((now - mtime))
  ((age >= stale_after)) || return 0

  rm -f "$RUNNING_LOCK_PID_FILE" 2>/dev/null || true
  lock_contents="$(find "$LOCK_DIR" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null || true)"
  if [[ -z "$lock_contents" ]] && rmdir "$LOCK_DIR" 2>/dev/null; then
    echo "$(timestamp) recovered stale running lock age=${age}s" >&2
  fi
}

try_acquire_running_lock() {
  recover_stale_running_lock
  mkdir "$LOCK_DIR" 2>/dev/null
}

write_running_lock_pid() {
  local pid="$1"
  [[ -d "$LOCK_DIR" ]] || return 0
  printf '%s\n' "$pid" >"$RUNNING_LOCK_PID_FILE" 2>/dev/null || true
}

clear_running_lock() {
  rm -f "$RUNNING_LOCK_PID_FILE" 2>/dev/null || true
  rmdir "$LOCK_DIR" 2>/dev/null || true
}

next_queue_file() {
  find "$TASK_QUEUE_DIR" -type f -name '*.json' 2>/dev/null | sort | head -n 1
}

pop_queue_task() {
  local queue_file queued_json queued_task_id queued_message_id queued_prompt queued_session_id queued_reply_mode queued_chat_id queued_title queued_timeout queued_job_id

  queue_file="$(next_queue_file)"
  [[ -n "$queue_file" && -f "$queue_file" ]] || return 1

  queued_json="$(cat "$queue_file")"
  rm -f "$queue_file"

  queued_task_id="$(jq -r '.task_id // empty' <<<"$queued_json")"
  queued_message_id="$(jq -r '.message_id // empty' <<<"$queued_json")"
  queued_prompt="$(jq -r '.prompt // empty' <<<"$queued_json")"
  queued_session_id="$(jq -r '.session_id // empty' <<<"$queued_json")"
  queued_reply_mode="$(jq -r '.reply_mode // "final"' <<<"$queued_json")"
  queued_chat_id="$(jq -r '.chat_id // empty' <<<"$queued_json")"
  queued_timeout="$(jq -r '.timeout_seconds // empty' <<<"$queued_json")"
  queued_job_id="$(jq -r '.job_id // empty' <<<"$queued_json")"

  if [[ -z "$queued_task_id" || -z "$queued_message_id" || -z "$queued_prompt" ]]; then
    return 1
  fi

  [[ -n "$queued_chat_id" ]] || queued_chat_id="unknown"
  [[ "$queued_timeout" =~ ^[0-9]+$ ]] || queued_timeout="$CODEX_TASK_TIMEOUT_SECONDS"
  chat_context_load "$queued_chat_id"
  run_codex_task "$queued_task_id" "$queued_message_id" "$queued_prompt" "$queued_session_id" "$queued_reply_mode" "$queued_timeout" "$queued_job_id"
}

queue_watch_loop() {
  while true; do
    sleep 5
    [[ -n "$(next_queue_file)" ]] || continue
    if try_acquire_running_lock; then
      pop_queue_task &
    fi
  done
}

terminate_pid_tree() {
  local pid="$1"

  pkill -TERM -P "$pid" 2>/dev/null || true
  kill -TERM "$pid" 2>/dev/null || true
  sleep 2
  pkill -KILL -P "$pid" 2>/dev/null || true
  kill -KILL "$pid" 2>/dev/null || true
}

wait_with_timeout() {
  local pid="$1"
  local timeout="${2:-$CODEX_TASK_TIMEOUT_SECONDS}"
  local started_at now

  started_at="$(date '+%s')"
  while kill -0 "$pid" 2>/dev/null; do
    now="$(date '+%s')"
    if ((now - started_at >= timeout)); then
      echo "$(timestamp) task timed out after ${timeout}s; terminating pid=$pid" >>"$TASK_LOG_FILE"
      terminate_pid_tree "$pid"
      wait "$pid" 2>/dev/null || true
      return 124
    fi
    sleep 2
  done

  wait "$pid"
}

enqueue_task() {
  local message_id="$1"
  local prompt="$2"
  local session_id="${3:-}"
  local reply_mode="${4:-final}"
  local chat_id="${5:-${CHAT_ID:-unknown}}"
  local timeout_seconds="${6:-$CODEX_TASK_TIMEOUT_SECONDS}"
  local job_id="${7:-}"
  local task_id filename tmp

  [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || timeout_seconds="$CODEX_TASK_TIMEOUT_SECONDS"
  task_id="$(date '+%Y%m%d%H%M%S')-$message_id"
  filename="$TASK_QUEUE_DIR/$(perl -MTime::HiRes=time -e 'printf "%.6f", time' | tr -d .)-$$-$RANDOM.json"
  tmp="$filename.tmp"
  jq -n \
    --arg task_id "$task_id" \
    --arg message_id "$message_id" \
    --arg chat_id "$chat_id" \
    --arg prompt "$prompt" \
    --arg session_id "$session_id" \
    --arg reply_mode "$reply_mode" \
    --arg job_id "$job_id" \
    --argjson timeout_seconds "$timeout_seconds" \
    --arg queued_at "$(timestamp)" \
    '{task_id:$task_id,message_id:$message_id,chat_id:$chat_id,prompt:$prompt,session_id:$session_id,reply_mode:$reply_mode,job_id:$job_id,timeout_seconds:$timeout_seconds,queued_at:$queued_at}' \
    >"$tmp"
  mv "$tmp" "$filename"
  [[ -n "$job_id" ]] && job_update_state "$job_id" "queued" "$task_id" "$message_id" "$prompt" "$session_id" "" "queued"
  terminal_create_card "$message_id" "QUEUED" "queued: $(printf '%s' "$prompt" | compact_text 220)" "$task_id" "$prompt" "$session_id" "0" "$job_id" "" || true

  : # queued
}

queue_text() {
  local count file index prompt session_id title queued_at chat_id chat_filter matched reply_mode
  local total

  total="$(queue_count)"
  if [[ "$total" == "0" ]]; then
    printf '队列为空。'
    return
  fi

  chat_filter="${CHAT_ID:-}"
  matched=0
  index=1
  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    chat_id="$(jq -r '.chat_id // empty' "$file" 2>/dev/null || true)"
    if [[ -n "$chat_filter" && -n "$chat_id" && "$chat_id" != "$chat_filter" ]]; then
      continue
    fi
    prompt="$(jq -r '.prompt // ""' "$file" | compact_text 80)"
    session_id="$(jq -r '.session_id // empty' "$file")"
    reply_mode="$(jq -r '.reply_mode // "final"' "$file")"
    queued_at="$(jq -r '.queued_at // ""' "$file")"
    if [[ -n "$session_id" ]]; then
      title="$(session_title "$session_id")"
      printf '[%s] %s -> %s\n%s\n\n' "$index" "$queued_at" "$title" "$prompt"
    elif [[ "$reply_mode" == "new_session" ]]; then
      printf '[%s] %s -> 新会话\n%s\n\n' "$index" "$queued_at" "$prompt"
    elif [[ "$reply_mode" == "long" || "$reply_mode" == "auto-long" ]]; then
      printf '[%s] %s -> terminal task\n%s\n\n' "$index" "$queued_at" "$prompt"
    else
      printf '[%s] %s -> 新任务\n%s\n\n' "$index" "$queued_at" "$prompt"
    fi
    matched=1
    index=$((index + 1))
  done < <(find "$TASK_QUEUE_DIR" -type f -name '*.json' 2>/dev/null | sort)

  if [[ "$matched" == "0" ]]; then
    printf '当前窗口队列为空。\n全局队列: %s' "$total"
  fi
}

status_text() {
  local queued

  if [[ ! -f "$STATUS_FILE" ]]; then
    queued="$(queue_count)"
    printf '还没有任务记录。直接发送要我处理的内容即可开始。\n队列: %s' "$queued"
    return
  fi

  jq -r '
    "状态: \(.state)\n任务: \(.task_id)\n时间: \(.updated_at)\n内容: \(.prompt)\n备注: \(.detail // "")"
  ' "$STATUS_FILE"
  queued="$(queue_count)"
  printf '\n队列: %s' "$queued"
}

status_card_json() {
  local queued state task_id updated prompt detail body extra

  queued="$(queue_count)"
  if [[ ! -f "$STATUS_FILE" ]]; then
    body="还没有任务记录。直接发送要我处理的内容即可开始。"
    extra="队列：$queued\n命令：目录 / logs / status"
    card_json "状态" "blue" "$body" "$extra"
    return
  fi

  state="$(jq -r '.state // ""' "$STATUS_FILE" 2>/dev/null || true)"
  task_id="$(jq -r '.task_id // ""' "$STATUS_FILE" 2>/dev/null || true)"
  updated="$(jq -r '.updated_at // ""' "$STATUS_FILE" 2>/dev/null || true)"
  prompt="$(jq -r '.prompt // ""' "$STATUS_FILE" 2>/dev/null || true)"
  detail="$(jq -r '.detail // ""' "$STATUS_FILE" 2>/dev/null || true)"
  prompt="$(printf '%s' "$prompt" | compact_text 220)"
  detail="$(printf '%s' "$detail" | compact_text 220)"

  body=$(
    printf '**状态**：%s\n' "${state:-unknown}"
    [[ -n "$prompt" ]] && printf '\n%s\n' "$prompt" || true
    [[ -n "$detail" ]] && printf '\n_%s_\n' "$detail" || true
  )
  extra=$(
    printf '**task_id**：%s\n' "${task_id:-}"
    printf '**更新时间**：%s\n' "${updated:-}"
    printf '**队列**：%s\n' "$queued"
    printf '命令：目录 / logs / 队列\n'
  )

  card_json "状态" "blue" "$body" "$extra"
}

reply_status() {
  local message_id="$1"
  local card

  if [[ "$DIRECTORY_FORMAT" == "card" ]]; then
    card="$(status_card_json)"
    reply_card "$message_id" "$card" || reply_text "$message_id" "$(status_text)"
  else
    reply_text "$message_id" "$(status_text)"
  fi
}

logs_text() {
  if [[ ! -f "$TASK_LOG_FILE" ]]; then
    printf '还没有任务日志。'
    return
  fi

  tail -n 80 "$TASK_LOG_FILE" |
    redact_log
}

redact_log() {
  sed -E \
    -e '/event type: im\.message\.reaction\.created_v1, not found handler/d' \
    -e 's/(LARKSUITE_CLI_APP_SECRET=)[^[:space:]]+/\1[redacted]/g' \
    -e 's/(FEISHU_APP_SECRET=)[^[:space:]]+/\1[redacted]/g' \
    -e 's/(tenant_access_token["=: ]+)[^",[:space:]]+/\1[redacted]/g' \
    -e 's/(Authorization: Bearer )[A-Za-z0-9._-]+/\1[redacted]/g'
}

recent_logs_text() {
  if [[ ! -f "$TASK_LOG_FILE" ]]; then
    printf '还没有任务日志。'
    return
  fi

  tail -n 25 "$TASK_LOG_FILE" |
    redact_log
}

compact_text() {
  local max="${1:-240}"
  TRUNCATE_MAX="$max" perl -CS -Mutf8 -0pe '
    BEGIN { $max = $ENV{"TRUNCATE_MAX"} || 240 }
    s/\s+/ /g;
    s/^\s+|\s+$//g;
    if (length($_) > $max) { $_ = substr($_, 0, $max) . "..." }
  '
}

valid_session_ref() {
  [[ "$1" =~ ^#?[A-Za-z0-9-]{1,80}$ ]]
}

sql_string_literal() {
  local value="$1"
  local escaped

  escaped="$(printf '%s' "$value" | sed "s/'/''/g")"
  printf "'%s'" "$escaped"
}

session_db_row() {
  local session_id="$1"

  valid_session_ref "$session_id" || return 1
  session_id="${session_id#\#}"

  [[ -f "$CODEX_STATE_DB" ]] || return 1
  sqlite3 -tabs -noheader "$CODEX_STATE_DB" "
    select
      id,
      coalesce(datetime(updated_at_ms / 1000, 'unixepoch', 'localtime'), ''),
      substr(replace(replace(coalesce(title, ''), char(10), ' '), char(13), ' '), 1, 72),
      coalesce(cwd, ''),
      coalesce(rollout_path, ''),
      coalesce(archived, 0)
    from threads
    where id = '$session_id'
    limit 1;
  "
}

session_title() {
  local row id updated title cwd rollout_path archived

  row="$(session_db_row "$1" || true)"
  if [[ -n "$row" ]]; then
    IFS=$'\t' read -r id updated title cwd rollout_path archived <<<"$row"
    printf '%s' "$title"
    return
  fi

  printf '%s' "$1"
}

latest_created_session_id_since() {
  local started_ms="$1"
  local cwd="${2:-${CHAT_WORKDIR:-$CODEX_WORKDIR}}"
  local cwd_sql threshold

  [[ -f "$CODEX_STATE_DB" ]] || return 1
  [[ "$started_ms" =~ ^[0-9]+$ ]] || return 1

  # Allow a small clock/commit margin around Codex's sqlite write.
  threshold=$((started_ms - 10000))
  if ((threshold < 0)); then
    threshold=0
  fi
  cwd_sql="$(sql_string_literal "$cwd")"

  sqlite3 -tabs -noheader "$CODEX_STATE_DB" "
    select id
    from threads
    where archived = 0
      and cwd = $cwd_sql
      and coalesce(created_at_ms, created_at * 1000, updated_at_ms, updated_at * 1000, 0) >= $threshold
    order by coalesce(created_at_ms, created_at * 1000, updated_at_ms, updated_at * 1000, 0) desc
    limit 1;
  " | head -n 1
}

session_alias_number() {
  local session_id="$1"

  [[ -f "$SESSION_ALIAS_FILE" ]] || return 1
  awk -F '\t' -v id="$session_id" '$2 == id { print $1; exit }' "$SESSION_ALIAS_FILE"
}

find_session_file() {
  local session_id="$1"
  local row id updated title cwd rollout_path archived

  valid_session_ref "$session_id" || return 1
  session_id="${session_id#\#}"

  row="$(session_db_row "$session_id" || true)"
  if [[ -n "$row" ]]; then
    IFS=$'\t' read -r id updated title cwd rollout_path archived <<<"$row"
    if [[ -n "${rollout_path:-}" && -f "$rollout_path" ]]; then
      printf '%s' "$rollout_path"
      return 0
    fi
  fi

  find "$CODEX_SESSIONS_ROOT" -type f -name "*$session_id*.jsonl" 2>/dev/null |
    tail -n 1
}

resolve_session_ref() {
  local ref="$1"
  local alias

  valid_session_ref "$ref" || return 1
  ref="${ref#\#}"

  if [[ "$ref" =~ ^[0-9]+$ && -f "$SESSION_ALIAS_FILE" ]]; then
    alias="$(awk -F '\t' -v n="$ref" '$1 == n { print $2; exit }' "$SESSION_ALIAS_FILE")"
    if [[ -n "$alias" ]]; then
      printf '%s' "$alias"
      return 0
    fi
  fi

  if [[ "$ref" =~ ^[A-Za-z0-9]+-[A-Za-z0-9-]+$ ]]; then
    printf '%s' "$ref"
    return 0
  fi

  return 1
}

session_recent_activity_text() {
  local file="$1"

  tail -n 700 "$file" |
    jq -r '
      def clean($n): tostring | gsub("[\\r\\n\\t ]+"; " ") | .[0:$n];
      def when: (.timestamp // "") | sub("T"; " ") | sub("\\..*"; "Z");
      if .type == "event_msg" and .payload.type == "user_message" then
        "- " + when + " 用户: " + (.payload.message | clean(220))
      elif .type == "event_msg" and .payload.type == "agent_message" then
        "- " + when + " Codex: " + (.payload.message | clean(320))
      elif .type == "event_msg" and .payload.type == "task_complete" then
        "- " + when + " 完成: " + ((.payload.last_agent_message // "任务完成") | clean(260))
      elif .type == "response_item" and .payload.type == "function_call" then
        "- " + when + " 工具: " + ((.payload.name // "function_call") | clean(80))
      else empty end
    ' |
    tail -n 10
}

session_stream_text() {
  local session_id="$1"
  local from_line="${2:-1}"
  local limit="${3:-24}"
  local file row id updated title cwd rollout_path archived number prefix body

  session_id="$(resolve_session_ref "$session_id" || true)"
  if [[ -z "$session_id" ]]; then
    printf 'codex-tail: unknown session. 发送 目录 查看编号。'
    return
  fi

  file="$(find_session_file "$session_id")"
  if [[ -z "$file" || ! -f "$file" ]]; then
    printf 'codex-tail: session file not found: %s' "$session_id"
    return
  fi

  row="$(session_db_row "$session_id" || true)"
  if [[ -n "$row" ]]; then
    IFS=$'\t' read -r id updated title cwd rollout_path archived <<<"$row"
  else
    title="$session_id"
    cwd=""
  fi
  number="$(session_alias_number "$session_id" || true)"
  [[ -n "$number" ]] && prefix="#$number " || prefix=""

  if ((from_line < 1)); then
    from_line=1
  fi

  body="$(
    tail -n +"$from_line" "$file" |
      jq -r '
        def clean($n): tostring | gsub("[\\r\\n\\t ]+"; " ") | .[0:$n];
        def tm:
          (.timestamp // "")
          | sub("T"; " ")
          | sub("\\..*"; "Z");
        if .type == "event_msg" and .payload.type == "user_message" then
          "[" + tm + "] user$ " + (.payload.message | clean(260))
        elif .type == "event_msg" and .payload.type == "agent_message" then
          "[" + tm + "] codex> " + (.payload.message | clean(420))
        elif .type == "event_msg" and .payload.type == "task_started" then
          "[" + tm + "] task> started"
        elif .type == "event_msg" and .payload.type == "task_complete" then
          "[" + tm + "] done> " + ((.payload.last_agent_message // "task complete") | clean(320))
        elif .type == "event_msg" and .payload.type == "exec_command_end" then
          "[" + tm + "] exec> " + ((.payload.cmd // .payload.command // "command finished") | clean(160))
        elif .type == "response_item" and .payload.type == "function_call" then
          "[" + tm + "] tool> " + ((.payload.name // "function_call") | clean(120))
        else empty end
      ' |
      tail -n "$limit"
  )"

  [[ -n "$body" ]] && printf '%s' "$body" || true
}

session_last_stream_line() {
  local session_id="$1"
  local file lines from_line out

  session_id="$(resolve_session_ref "$session_id" || true)"
  [[ -n "$session_id" ]] || return 1

  file="$(find_session_file "$session_id")"
  [[ -n "$file" && -f "$file" ]] || return 1

  lines="$(wc -l <"$file" | tr -d ' ')"
  [[ "$lines" =~ ^[0-9]+$ ]] || return 1
  ((lines > 0)) || return 1

  from_line=$((lines - 200))
  ((from_line < 1)) && from_line=1

  out="$(session_stream_text "$session_id" "$from_line" 200 | tail -n 1 || true)"
  [[ -n "$out" ]] || return 1
  printf '%s' "$out"
}

session_summary_text() {
  local session_id="$1"
  local file row id updated title cwd rollout_path archived lines last_ts activity

  session_id="$(resolve_session_ref "$session_id" || true)"
  if [[ -z "$session_id" ]]; then
    printf '没有找到这个会话编号。发送 目录 查看当前可用编号。'
    return
  fi

  file="$(find_session_file "$session_id")"
  if [[ -z "$file" || ! -f "$file" ]]; then
    printf '找到了会话编号，但没有找到对应的会话文件：%s' "$session_id"
    return
  fi

  row="$(session_db_row "$session_id" || true)"
  if [[ -n "$row" ]]; then
    IFS=$'\t' read -r id updated title cwd rollout_path archived <<<"$row"
  else
    title="$session_id"
    updated=""
    cwd=""
    archived="0"
  fi

  lines="$(wc -l <"$file" | tr -d ' ')"
  last_ts="$(tail -n 1 "$file" | jq -r '.timestamp // empty' 2>/dev/null || true)"
  activity="$(session_recent_activity_text "$file" || true)"
  [[ -n "$activity" ]] || activity='- 暂无可读进展。'

  printf '会话进度\n'
  printf '编号/ID: %s\n' "$session_id"
  printf '标题: %s\n' "${title:-未命名}"
  [[ -n "${updated:-}" ]] && printf '索引更新时间: %s\n' "$updated"
  [[ -n "${last_ts:-}" ]] && printf '最后事件: %s\n' "$last_ts"
  [[ -n "${cwd:-}" ]] && printf '工作区: %s\n' "$cwd"
  printf '记录行数: %s\n\n' "$lines"
  printf '最近进展:\n%s' "$activity"
}

set_active_session() {
  local session_id="$1"
  local title

  title="$(session_title "$session_id")"
  jq -n \
    --arg session_id "$session_id" \
    --arg title "$title" \
    --arg started_at "$(timestamp)" \
    --argjson expires_at 0 \
    --argjson persistent true \
    '{session_id:$session_id,title:$title,started_at:$started_at,expires_at:$expires_at,persistent:$persistent}' \
    >"$ACTIVE_SESSION_FILE"
  clear_new_session_pending
}

active_session_id() {
  local session_id

  [[ -f "$ACTIVE_SESSION_FILE" ]] || return 1
  session_id="$(jq -r '.session_id // empty' "$ACTIVE_SESSION_FILE" 2>/dev/null || true)"
  if [[ -n "$session_id" ]]; then
    printf '%s' "$session_id"
    return 0
  fi

  return 1
}

set_new_session_pending() {
  jq -n \
    --arg started_at "$(timestamp)" \
    '{pending:true,started_at:$started_at}' \
    >"$NEW_SESSION_FILE"
  rm -f "$ACTIVE_SESSION_FILE"
}

clear_new_session_pending() {
  rm -f "$NEW_SESSION_FILE"
}

new_session_pending() {
  [[ -f "$NEW_SESSION_FILE" ]]
}

active_session_remaining_seconds() {
  local now expires_at remaining

  [[ -f "$ACTIVE_SESSION_FILE" ]] || return 1
  now="$(date '+%s')"
  expires_at="$(jq -r '.expires_at // 0' "$ACTIVE_SESSION_FILE" 2>/dev/null || printf '0')"
  [[ "$expires_at" =~ ^[0-9]+$ ]] || return 1
  remaining=$((expires_at - now))
  ((remaining > 0)) || return 1
  printf '%s' "$remaining"
}

sync_remaining_seconds() {
  local now expires_at remaining

  [[ -f "$SYNC_FILE" ]] || return 1
  now="$(date '+%s')"
  expires_at="$(jq -r '.expires_at // 0' "$SYNC_FILE" 2>/dev/null || printf '0')"
  [[ "$expires_at" =~ ^[0-9]+$ ]] || return 1
  remaining=$((expires_at - now))
  ((remaining > 0)) || return 1
  printf '%s' "$remaining"
}

update_sync_session() {
  local session_id="$1"
  local seconds="$2"
  local expires_at tmp

  [[ -f "$SYNC_FILE" ]] || return 1
  expires_at=$(($(date '+%s') + seconds))
  tmp="$SYNC_FILE.$$"
  jq \
    --arg session_id "$session_id" \
    --argjson expires_at "$expires_at" \
    '.session_id = $session_id | .expires_at = $expires_at' \
    "$SYNC_FILE" >"$tmp"
  mv "$tmp" "$SYNC_FILE"
}

switch_session_ref() {
  local message_id="$1"
  local ref="$2"
  local requested_seconds="${3:-}"
  local session_id title seconds number label last_line body

  session_id="$(resolve_session_ref "$ref" || true)"
  if [[ -z "$session_id" ]]; then
    reply "$message_id" "没有找到这个会话编号。发送 目录 查看当前可用编号。"
    return
  fi

  title="$(session_title "$session_id")"
  number="$(session_alias_number "$session_id" || true)"
  [[ -n "$number" ]] && label="#$number $title" || label="$title"
  last_line="$(session_last_stream_line "$session_id" 2>/dev/null || true)"
  if [[ -n "$last_line" ]]; then
    last_line="$(printf '%s' "$last_line" | terminal_safe_fence_text)"
    body="$(printf '%s\n\n```text\n%s\n```' "$label" "$last_line")"
  else
    body="$label"
  fi
  if [[ -n "$requested_seconds" ]]; then
    seconds="$requested_seconds"
  else
    seconds="$(sync_remaining_seconds || true)"
  fi

  set_active_session "$session_id"
  if [[ -d "$SYNC_LOCK_DIR" ]]; then
    [[ -n "$seconds" ]] || seconds=600
    update_sync_session "$session_id" "$seconds" || true
    reply_notice "$message_id" "✅ 已常驻" "green" "$body" "同步流已切换。发送 停止同步 可结束同步。" "✅ 已常驻: $label"$'\n'"同步流已切换。"
  elif [[ -n "$seconds" ]]; then
    start_sync "$message_id" "$seconds" "$session_id"
  else
    reply_notice "$message_id" "✅ 已常驻" "green" "$body" "普通消息会进入这个会话；发送 清除会话 可取消。" "✅ 已常驻: $label"
  fi
}

current_session_text() {
  local session_id title

  session_id="$(active_session_id || true)"
  if [[ -z "$session_id" ]]; then
    printf '当前没有绑定会话。发送 目录 查看编号，然后发送 切换 1。'
    return
  fi

  title="$(session_title "$session_id")"
  printf '当前会话\n标题: %s\nID: %s\n\n普通消息会发送到这个会话。发送 清除会话 可取消。' "$title" "$session_id"
}

reply_current_session() {
  local message_id="$1"
  local session_id title number label body detail

  session_id="$(active_session_id || true)"
  if [[ -z "$session_id" ]]; then
    body="未绑定会话。发送 目录 查看编号，然后发送 切换 1。"
    detail="命令：目录 / 切换 N / 新任务 <内容>"
    reply_notice "$message_id" "当前会话" "blue" "$body" "$detail" "$body"
    return
  fi

  title="$(session_title "$session_id")"
  number="$(session_alias_number "$session_id" || true)"
  [[ -n "$number" ]] && label="#$number $title" || label="${title:-未命名}"
  body="$label"
  detail=$(
    printf '**ID**：%s\n' "$session_id"
    printf '命令：清除会话 / 会话 %s / 同步会话 %s 10分钟\n' "${number:-$session_id}" "${number:-$session_id}"
  )
  reply_notice "$message_id" "当前会话" "blue" "$body" "$detail" "$label"
}

detach_active_session() {
  local message_id="$1"

  rm -f "$ACTIVE_SESSION_FILE"
  clear_new_session_pending
  reply_notice "$message_id" "✅ 已清除会话" "green" "后续普通消息会创建新任务。" "命令：目录 / 切换 N / 新任务 <内容>" "✅ 已清除当前会话。后续普通消息会创建新任务。"
}

reply_pwd() {
  local message_id="$1"
  local workdir="${CHAT_WORKDIR:-$CODEX_WORKDIR}"
  reply_notice "$message_id" "工作目录" "blue" "$workdir" "命令：cd /path 或 cwd /path" "$workdir"
}

cmd_cd() {
  local message_id="$1"
  local arg_path="$2"
  local base expanded target abs

  expanded="$(expand_path "$arg_path")"
  base="${CHAT_WORKDIR:-$CODEX_WORKDIR}"
  if [[ -n "$expanded" && "$expanded" != /* ]]; then
    target="$base/$expanded"
  else
    target="$expanded"
  fi

  if abs="$(cd "$target" 2>/dev/null && pwd)"; then
    chat_settings_set "workdir" "$abs"
    reply_notice "$message_id" "✅ 已设置工作目录" "green" "$abs" "命令：pwd" "✅ 已设置工作目录: $abs"
  else
    reply_notice "$message_id" "❌ 目录不可用" "red" "$target" "请发送一个存在的本地目录路径（例如：cd ~/Documents）" "❌ 目录不可用: $target"
  fi
}

cmd_debug() {
  local message_id="$1"
  local mode="$2"

  case "$mode" in
    on|true|1|enable|enabled)
      chat_settings_set "debug" "true"
      reply_notice "$message_id" "Debug" "blue" "已开启 debug。" "之后卡片折叠区会更详细。" "debug on"
      ;;
    off|false|0|disable|disabled)
      chat_settings_set "debug" "false"
      reply_notice "$message_id" "Debug" "blue" "已关闭 debug。" "" "debug off"
      ;;
    *)
      reply_notice "$message_id" "Debug" "blue" "用法：debug on / debug off" "" "用法：debug on / debug off"
      ;;
  esac
}

cmd_syncmode() {
  local message_id="$1"
  local mode="$2"

  case "$mode" in
    stream|screen)
      chat_settings_set "sync_render" "$mode"
      reply_notice "$message_id" "同步渲染" "blue" "已设置为：$mode" "screen 模式需要 im:message:update 权限；失败会自动降级为 stream。" "已设置同步渲染: $mode"
      ;;
    *)
      reply_notice "$message_id" "同步渲染" "blue" "用法：syncmode stream / syncmode screen" "" "用法：syncmode stream / syncmode screen"
      ;;
  esac
}

cmd_update_mode() {
  local message_id="$1"
  local mode="$2"

  case "$mode" in
    on|true|1|enable|enabled)
      chat_settings_set "enable_message_update" "true"
      reply_notice "$message_id" "消息更新" "blue" "已开启 message update。" "需要 im:message:update 权限；失败会自动降级为逐条 stream。" "update on"
      ;;
    off|false|0|disable|disabled)
      chat_settings_set "enable_message_update" "false"
      reply_notice "$message_id" "消息更新" "blue" "已关闭 message update。" "" "update off"
      ;;
    *)
      reply_notice "$message_id" "消息更新" "blue" "用法：update on / update off" "" "用法：update on / update off"
      ;;
  esac
}

build_session_directory_text() {
  local tmp number seen out id row updated title cwd rollout_path archived current_id marker

  tmp="$SESSION_ALIAS_FILE.$$"
  : >"$tmp"
  number=1
  seen=" "
  current_id="$(active_session_id || true)"
  out="会话目录"$'\n'
  if [[ -n "$current_id" ]]; then
    out+="当前: $(session_title "$current_id")  $(short_id "$current_id")"$'\n'
  else
    out+="当前: 未绑定"$'\n'
  fi

  if [[ -s "$PINNED_SESSIONS_FILE" ]]; then
    out+=$'\n'"置顶:"$'\n'
    while IFS= read -r id; do
      valid_session_ref "$id" || continue
      id="${id#\#}"
      [[ "$seen" == *" $id "* ]] && continue
      row="$(session_db_row "$id" || true)"
      [[ -n "$row" ]] || continue
      IFS=$'\t' read -r id updated title cwd rollout_path archived <<<"$row"
      printf '%s\t%s\t%s\t%s\n' "$number" "$id" "$title" "$updated" >>"$tmp"
      [[ "$id" == "$current_id" ]] && marker=" ← 当前" || marker=""
      out+="[$number] $title$marker  $updated  $(short_id "$id")"$'\n'
      seen+=" $id "
      number=$((number + 1))
    done <"$PINNED_SESSIONS_FILE"
  fi

  out+=$'\n'"最近:"$'\n'
  if [[ -f "$CODEX_STATE_DB" ]]; then
    while IFS=$'\t' read -r id updated title cwd rollout_path archived; do
      [[ -n "$id" ]] || continue
      [[ "$seen" == *" $id "* ]] && continue
      printf '%s\t%s\t%s\t%s\n' "$number" "$id" "$title" "$updated" >>"$tmp"
      [[ "$id" == "$current_id" ]] && marker=" ← 当前" || marker=""
      out+="[$number] $title$marker  $updated  $(short_id "$id")"$'\n'
      seen+=" $id "
      number=$((number + 1))
    done < <(
      sqlite3 -tabs -noheader "$CODEX_STATE_DB" "
        select
          id,
          coalesce(datetime(updated_at_ms / 1000, 'unixepoch', 'localtime'), ''),
          substr(replace(replace(coalesce(title, ''), char(10), ' '), char(13), ' '), 1, 72),
          coalesce(cwd, ''),
          coalesce(rollout_path, ''),
          coalesce(archived, 0)
        from threads
        where archived = 0
        order by updated_at_ms desc
        limit $DIRECTORY_LIMIT;
      "
    )
  fi

  if ((number == 1)); then
    rm -f "$tmp"
    printf '还没有找到可编号的 Codex 会话。'
    return
  fi

  mv "$tmp" "$SESSION_ALIAS_FILE"
  out+=$'\n'"命令: 切换 N / 会话 N / 同步会话 N 10分钟 / 清除会话"
  printf '%s' "$out"
}

directory_card_json() {
  local directory_text="$1"
  local body

  body="$(printf '%s' "$directory_text")"
  card_json "会话目录" "blue" "$body" "普通消息默认发送到当前会话"
}

reply_directory() {
  local message_id="$1"
  local directory_text card

  directory_text="$(build_session_directory_text)"
  if [[ "$DIRECTORY_FORMAT" == "card" ]]; then
    card="$(directory_card_json "$directory_text")"
    reply_card "$message_id" "$card" || reply_text "$message_id" "$directory_text"
  else
    reply_text "$message_id" "$directory_text"
  fi
}

pin_session_ref() {
  local message_id="$1"
  local ref="$2"
  local session_id title tmp

  session_id="$(resolve_session_ref "$ref" || true)"
  if [[ -z "$session_id" ]]; then
    reply_notice "$message_id" "❌ 未找到会话" "red" "没有找到这个会话编号。" "先发送 目录 获取编号。" "没有找到这个会话编号。先发送 目录 获取编号。"
    return
  fi

  title="$(session_title "$session_id")"
  tmp="$PINNED_SESSIONS_FILE.$$"
  { [[ -f "$PINNED_SESSIONS_FILE" ]] && grep -v -F -x "$session_id" "$PINNED_SESSIONS_FILE" || true; printf '%s\n' "$session_id"; } >"$tmp"
  mv "$tmp" "$PINNED_SESSIONS_FILE"
  reply_notice "$message_id" "已置顶" "green" "$title" "**ID**：$session_id" "已置顶: $title"$'\n'"$session_id"
}

unpin_session_ref() {
  local message_id="$1"
  local ref="$2"
  local session_id title tmp

  session_id="$(resolve_session_ref "$ref" || true)"
  if [[ -z "$session_id" ]]; then
    reply_notice "$message_id" "❌ 未找到会话" "red" "没有找到这个会话编号。" "先发送 目录 获取编号。" "没有找到这个会话编号。先发送 目录 获取编号。"
    return
  fi

  title="$(session_title "$session_id")"
  tmp="$PINNED_SESSIONS_FILE.$$"
  [[ -f "$PINNED_SESSIONS_FILE" ]] && grep -v -F -x "$session_id" "$PINNED_SESSIONS_FILE" >"$tmp" || : >"$tmp"
  mv "$tmp" "$PINNED_SESSIONS_FILE"
  reply_notice "$message_id" "已取消置顶" "blue" "$title" "" "已取消置顶: $title"
}

parse_sync_seconds() {
  local text="$1"
  local amount unit seconds

  if [[ "$text" =~ ^(同步|sync)$ ]]; then
    printf '600'
    return 0
  fi

  if [[ "$text" =~ ^(同步|sync)[[:space:]]*([0-9]+)[[:space:]]*(秒|s|sec|second|seconds)$ ]]; then
    amount="${BASH_REMATCH[2]}"
    seconds="$amount"
  elif [[ "$text" =~ ^(同步|sync)[[:space:]]*([0-9]+)[[:space:]]*(分钟|分|m|min|minute|minutes)?$ ]]; then
    amount="${BASH_REMATCH[2]}"
    unit="${BASH_REMATCH[3]:-分钟}"
    case "$unit" in
      秒|s|sec|second|seconds) seconds="$amount" ;;
      *) seconds=$((amount * 60)) ;;
    esac
  else
    return 1
  fi

  if ((seconds < 15)); then
    seconds=15
  fi
  if ((seconds > SYNC_MAX_SECONDS)); then
    seconds="$SYNC_MAX_SECONDS"
  fi

  printf '%s' "$seconds"
}

parse_duration_seconds() {
  local text="${1:-}"

  if [[ -z "$text" ]]; then
    printf '600'
    return 0
  fi

  parse_sync_seconds "同步 $text"
}

sync_snapshot_text() {
  local session_id="${1:-}"

  if [[ -n "$session_id" ]]; then
    printf '会话同步 %s\n\n%s' \
      "$(timestamp)" \
      "$(session_summary_text "$session_id")"
    return
  fi

  printf '进度同步 %s\n\n%s\n\n最近日志:\n%s' \
    "$(timestamp)" \
    "$(status_text)" \
    "$(recent_logs_text)"
}

sync_delta_card_json() {
  local session_id="$1"
  local delta="$2"
  local title template detail label number
  local body

  title="同步"
  template="blue"
  label="$(session_title "$session_id")"
  number="$(session_alias_number "$session_id" || true)"
  [[ -n "$number" ]] && label="#$number $label"

  body=$(
    printf '```text\n%s\n```' "$delta"
  )

  detail=$(
    printf '**会话**：%s\n' "$label"
    printf '**ID**：%s\n' "$session_id"
    printf '命令：停止同步 / 切换 N / 清除会话\n'
  )

  card_json "$title" "$template" "$body" "$detail"
}

reply_sync_delta() {
  local message_id="$1"
  local session_id="$2"
  local delta="$3"
  local card

  [[ -n "$delta" ]] || return 0

  if [[ "${SYNC_SCREEN_MODE:-false}" == "true" && -n "${SYNC_SCREEN_MESSAGE_ID:-}" && -n "${SYNC_SCREEN_BUFFER_FILE:-}" ]]; then
    # Append to rolling screen buffer, then update the same message card.
    {
      printf '%s\n' "$delta"
    } >>"$SYNC_SCREEN_BUFFER_FILE" || true
    tail -n "${SYNC_SCREEN_MAX_LINES:-180}" "$SYNC_SCREEN_BUFFER_FILE" >"$SYNC_SCREEN_BUFFER_FILE.$$" 2>/dev/null || true
    mv "$SYNC_SCREEN_BUFFER_FILE.$$" "$SYNC_SCREEN_BUFFER_FILE" 2>/dev/null || true

    card="$(sync_delta_card_json "$session_id" "$(cat "$SYNC_SCREEN_BUFFER_FILE" 2>/dev/null || printf '%s' "$delta")")"
    if update_interactive_message "$SYNC_SCREEN_MESSAGE_ID" "$card"; then
      return 0
    fi

    # If updates fail (missing scope, rate limit, etc), degrade to stream.
    SYNC_SCREEN_MODE="false"
  fi

  card="$(sync_delta_card_json "$session_id" "$delta")"
  reply_card "$message_id" "$card" || reply_text "$message_id" "$delta"
}

sync_screen_init() {
  local message_id="$1"
  local session_id="$2"
  local card new_id

  SYNC_SCREEN_MODE="false"
  SYNC_SCREEN_MESSAGE_ID=""
  SYNC_SCREEN_BUFFER_FILE="${CHAT_STATE_DIR:-$STATE_DIR}/sync.screen.txt"
  : >"$SYNC_SCREEN_BUFFER_FILE" || true

  card="$(sync_delta_card_json "$session_id" "")"
  if new_id="$(reply_card_capture_message_id "$message_id" "$card" 2>/dev/null)"; then
    SYNC_SCREEN_MESSAGE_ID="$new_id"
    SYNC_SCREEN_MODE="true"
    return 0
  fi

  SYNC_SCREEN_MODE="false"
  return 1
}

sync_loop() {
  local message_id="$1"
  local seconds="$2"
  local session_id="${3:-}"
  local started_at end_at state sleep_for last_lines current_lines session_file first_line current_active sync_expires delta label number

  started_at="$(date '+%s')"
  end_at=$((started_at + seconds))

  jq -n \
    --arg message_id "$message_id" \
    --arg started_at "$(timestamp)" \
    --arg session_id "$session_id" \
    --argjson seconds "$seconds" \
    --argjson expires_at "$end_at" \
    --argjson interval "$SYNC_INTERVAL_SECONDS" \
    '{message_id:$message_id,started_at:$started_at,session_id:$session_id,duration_seconds:$seconds,expires_at:$expires_at,interval_seconds:$interval}' \
    >"$SYNC_FILE"

  last_lines=0

  if [[ "${CHAT_SYNC_RENDER:-stream}" == "screen" && "${CHAT_ENABLE_MESSAGE_UPDATE:-false}" == "true" ]]; then
    sync_screen_init "$message_id" "$session_id" || true
  fi

		  if [[ -n "$session_id" ]]; then
		    set_active_session "$session_id"
		    session_file="$(find_session_file "$session_id")"
		    if [[ -n "$session_file" && -f "$session_file" ]]; then
		      current_lines="$(wc -l <"$session_file" | tr -d ' ')"
		      first_line=$((current_lines - 500))
		      if ((first_line < 1)); then
		        first_line=1
		      fi
		      delta="$(session_stream_text "$session_id" "$first_line" 24 false)"
		      reply_sync_delta "$message_id" "$session_id" "$delta" || true
		      last_lines="$current_lines"
		    else
		      delta="$(session_stream_text "$session_id" 1 24 false)"
		      reply_sync_delta "$message_id" "$session_id" "$delta" || true
		    fi
		  fi

  while :; do
    if [[ -f "$SYNC_FILE" ]]; then
      sync_expires="$(jq -r '.expires_at // empty' "$SYNC_FILE" 2>/dev/null || true)"
      [[ "$sync_expires" =~ ^[0-9]+$ ]] && end_at="$sync_expires"
    fi
    (( $(date '+%s') < end_at )) || break

    if [[ -f "$SYNC_STOP_FILE" ]]; then
      reply_notice "$message_id" "已停止同步" "blue" "同步已停止。" "命令：同步会话 N 10分钟 / 停止同步" "已停止进度同步。"
      break
    fi

    if [[ -n "$session_id" ]]; then
      current_active="$(active_session_id || true)"
      if [[ -n "$current_active" && "$current_active" != "$session_id" ]]; then
        session_id="$current_active"
        session_file="$(find_session_file "$session_id")"
        current_lines=0
        if [[ -n "$session_file" && -f "$session_file" ]]; then
          current_lines="$(wc -l <"$session_file" | tr -d ' ')"
          first_line=$((current_lines - 500))
          if ((first_line < 1)); then
            first_line=1
          fi
        else
          first_line=1
	      fi
	      last_lines="$current_lines"
	      label="$(session_title "$session_id")"
	      number="$(session_alias_number "$session_id" || true)"
		      [[ -n "$number" ]] && label="#$number $label"
			      delta="$(session_stream_text "$session_id" "$first_line" 18 false)"
			      if [[ "${SYNC_SCREEN_MODE:-false}" == "true" ]]; then
			        reply_sync_delta "$message_id" "$session_id" "sync> switched to: $label" || true
			        reply_sync_delta "$message_id" "$session_id" "$delta" || true
			      else
			        if [[ -n "$delta" ]]; then
			          reply_notice "$message_id" "同步已切换" "blue" "$(printf '```text\n%s\n```' "$delta")" "已切换到：$label\n命令：停止同步" "同步切换到: $label"$'\n\n'"$delta" || true
			        else
			          reply_notice "$message_id" "同步已切换" "blue" "$label" "命令：停止同步" "同步切换到: $label" || true
			        fi
			      fi
			    fi

      session_file="$(find_session_file "$session_id")"
      current_lines=0
      [[ -n "$session_file" && -f "$session_file" ]] && current_lines="$(wc -l <"$session_file" | tr -d ' ')"
      if ((last_lines > 0 && current_lines == last_lines)); then
        : # no-op; keep silent when no new events
      else
		        if ((last_lines > 0)); then
		          delta="$(session_stream_text "$session_id" $((last_lines + 1)) 30 false)"
		          reply_sync_delta "$message_id" "$session_id" "$delta" || true
		        else
		          delta="$(session_stream_text "$session_id" 1 30 false)"
		          reply_sync_delta "$message_id" "$session_id" "$delta" || true
		        fi
		      fi
	      last_lines="$current_lines"
	    else
	      # Disabled: avoid watchdog-style periodic pushes when no session is bound.
	      true
	    fi

    state=""
    if [[ -z "$session_id" && -f "$STATUS_FILE" ]]; then
      state="$(jq -r '.state // empty' "$STATUS_FILE")"
    fi
    if [[ "$state" == "completed" || "$state" == "failed" ]]; then
      break
    fi

    if [[ -n "$session_id" ]]; then
      sleep_for="$SESSION_STREAM_INTERVAL_SECONDS"
    else
      sleep_for="$SYNC_INTERVAL_SECONDS"
    fi
    if (( $(date '+%s') + sleep_for > end_at )); then
      sleep_for=$((end_at - $(date '+%s')))
    fi
    if ((sleep_for <= 0)); then
      break
    fi
    sleep "$sleep_for"
  done

  rm -f "$SYNC_FILE" "$SYNC_STOP_FILE"
  rmdir "$SYNC_LOCK_DIR" 2>/dev/null || true
}

start_sync() {
  local message_id="$1"
  local seconds="$2"
  local session_id="${3:-}"

  if [[ -z "$session_id" ]]; then
    session_id="$(active_session_id || true)"
  fi
  if [[ -z "$session_id" ]]; then
    reply_notice "$message_id" "❌ 无可同步会话" "red" "当前没有绑定会话。" "先发送 目录 获取编号，然后发送：切换 1 或 同步会话 1 10分钟" "当前没有绑定会话。先发送 目录 获取编号，然后发送：切换 1 或 同步会话 1 10分钟"
    return
  fi

  if ! mkdir "$SYNC_LOCK_DIR" 2>/dev/null; then
    if [[ -n "$session_id" ]]; then
      switch_session_ref "$message_id" "$session_id" "$seconds"
      return
    fi
    reply_notice "$message_id" "已有同步在运行" "blue" "发送 停止同步 结束当前同步。" "" "已有进度同步正在运行。发送 停止同步 结束当前同步。"
    return
  fi

  rm -f "$SYNC_STOP_FILE"
  if [[ -n "$session_id" ]]; then
    set_active_session "$session_id"
    if [[ "${CHAT_SYNC_RENDER:-stream}" == "screen" && "${CHAT_ENABLE_MESSAGE_UPDATE:-false}" == "true" ]]; then
      : # screen mode will post/update a single card; avoid extra chatter
    else
      reply_notice "$message_id" "已开始同步" "blue" "$(session_title "$session_id")" "时长：${seconds}s\n命令：停止同步" "已开始同步（${seconds}s）。会话已常驻；发送 停止同步 可结束同步。"
    fi
  fi
  sync_loop "$message_id" "$seconds" "$session_id" &
}

stop_sync() {
  local message_id="$1"

  if [[ ! -d "$SYNC_LOCK_DIR" ]]; then
    reply_notice "$message_id" "没有同步在运行" "blue" "当前没有正在运行的同步。" "" "当前没有正在运行的进度同步。"
    return
  fi

  : >"$SYNC_STOP_FILE"
  reply_notice "$message_id" "收到" "blue" "正在停止同步（会话常驻不变）。" "" "收到，正在停止同步（会话常驻不变）。"
}

start_new_session_task() {
  local message_id="$1"
  local prompt="$2"
  local task_id job_id

  clear_new_session_pending
  job_id="$(create_long_job "$message_id" "$prompt" "" "$CODEX_LONG_TASK_TIMEOUT_SECONDS" "new_session")"
  if ! try_acquire_running_lock; then
    enqueue_task "$message_id" "$prompt" "" "new_session" "${CHAT_ID:-unknown}" "$CODEX_LONG_TASK_TIMEOUT_SECONDS" "$job_id"
    return
  fi

  task_id="$(date '+%Y%m%d%H%M%S')-$message_id"
  set_status "queued" "$task_id" "$message_id" "$prompt" "将创建新会话并常驻"
  terminal_create_card "$message_id" "RUNNING" "starting new session..." "$task_id" "$prompt" "" "0" "$job_id" "" || true
  run_codex_task "$task_id" "$message_id" "$prompt" "" "new_session" "$CODEX_LONG_TASK_TIMEOUT_SECONDS" "$job_id" &
}

start_long_task() {
  local message_id="$1"
  local prompt="$2"
  local session_id="${3:-}"
  local use_active="${4:-true}"
  local job_id task_id

  if [[ -z "$session_id" && "$use_active" == "true" ]]; then
    session_id="$(active_session_id || true)"
  fi
  job_id="$(create_long_job "$message_id" "$prompt" "$session_id" "$CODEX_LONG_TASK_TIMEOUT_SECONDS" "long")"

  if ! try_acquire_running_lock; then
    enqueue_task "$message_id" "$prompt" "$session_id" "long" "${CHAT_ID:-unknown}" "$CODEX_LONG_TASK_TIMEOUT_SECONDS" "$job_id"
    return
  fi

  task_id="$(date '+%Y%m%d%H%M%S')-$message_id"
  set_status "queued" "$task_id" "$message_id" "$prompt" "长任务已启动，超时 ${CODEX_LONG_TASK_TIMEOUT_SECONDS}s"
  terminal_create_card "$message_id" "RUNNING" "working..." "$task_id" "$prompt" "$session_id" "0" "$job_id" "" || true
  run_codex_task "$task_id" "$message_id" "$prompt" "$session_id" "long" "$CODEX_LONG_TASK_TIMEOUT_SECONDS" "$job_id" &
}

continue_long_task() {
  local message_id="$1"
  local job_ref="${2:-}"
  local job_id job_file state session_id prompt timeout_seconds task_id

  job_id="$(resolve_job_ref "$job_ref" || true)"
  if [[ -z "$job_id" ]]; then
    session_id="$(active_session_id || true)"
    if [[ -z "$session_id" ]]; then
      reply_notice "$message_id" "没有可继续的长任务" "blue" "还没有长任务记录。发送：长任务 <内容>" "" "还没有长任务记录。发送：长任务 <内容>"
      return
    fi

    prompt="$(fallback_continue_prompt)"
    job_id="$(create_long_job "$message_id" "$prompt" "$session_id" "$CODEX_LONG_TASK_TIMEOUT_SECONDS" "long")"
    if ! try_acquire_running_lock; then
      enqueue_task "$message_id" "$prompt" "$session_id" "long" "${CHAT_ID:-unknown}" "$CODEX_LONG_TASK_TIMEOUT_SECONDS" "$job_id"
      return
    fi

    task_id="$(date '+%Y%m%d%H%M%S')-$message_id"
    set_status "queued" "$task_id" "$message_id" "$prompt" "旧任务继续已升级为长任务"
    terminal_create_card "$message_id" "RUNNING" "continuing..." "$task_id" "$prompt" "$session_id" "0" "$job_id" "" || true
    run_codex_task "$task_id" "$message_id" "$prompt" "$session_id" "long" "$CODEX_LONG_TASK_TIMEOUT_SECONDS" "$job_id" &
    return
  fi

  job_file="$(job_file_path "$job_id")"
  state="$(jq -r '.state // empty' "$job_file")"
  if [[ "$state" == "running" ]]; then
    reply_notice "$message_id" "长任务运行中" "blue" "$(job_summary_text "$job_id")" "命令：任务 / logs" "长任务仍在运行。"
    return
  fi
  if [[ "$state" == "queued" ]]; then
    reply_notice "$message_id" "任务已在队列中" "blue" "$(job_summary_text "$job_id")" "命令：tasks / queue" "任务已在队列中。"
    return
  fi
  if [[ "$state" == "completed" ]]; then
    reply_notice "$message_id" "任务已完成" "green" "$(job_summary_text "$job_id")" "继续迭代请直接发送新消息，或发送 new <内容>。" "任务已完成。继续迭代请直接发送新消息。"
    return
  fi

  session_id="$(jq -r '.session_id // empty' "$job_file")"
  [[ -n "$session_id" ]] || session_id="$(active_session_id || true)"
  timeout_seconds="$(jq -r ".timeout_seconds // $CODEX_LONG_TASK_TIMEOUT_SECONDS" "$job_file")"
  [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || timeout_seconds="$CODEX_LONG_TASK_TIMEOUT_SECONDS"
  prompt="$(job_continue_prompt "$job_id")"

  if ! try_acquire_running_lock; then
    enqueue_task "$message_id" "$prompt" "$session_id" "long" "${CHAT_ID:-unknown}" "$timeout_seconds" "$job_id"
    return
  fi

  task_id="$(date '+%Y%m%d%H%M%S')-$message_id"
  set_status "queued" "$task_id" "$message_id" "$prompt" "正在继续长任务"
  terminal_create_card "$message_id" "RUNNING" "continuing..." "$task_id" "$prompt" "$session_id" "0" "$job_id" "" || true
  run_codex_task "$task_id" "$message_id" "$prompt" "$session_id" "long" "$timeout_seconds" "$job_id" &
}

run_codex_task() {
  local task_id="$1"
  local message_id="$2"
  local prompt="$3"
  local session_id="${4:-}"
  local reply_mode="${5:-final}"
  local timeout_seconds="${6:-$CODEX_TASK_TIMEOUT_SECONDS}"
  local job_id="${7:-}"
  local output_file codex_exit codex_pid
  local started_epoch started_ms elapsed_seconds
  local resume_args=()
  local new_session_id
  local failure_answer failure_reason result_status
  local progress_pid="" progress_stop_file="" progress_initial_lines=0

  [[ "$timeout_seconds" =~ ^[0-9]+$ ]] || timeout_seconds="$CODEX_TASK_TIMEOUT_SECONDS"
  started_epoch="$(date '+%s')"
  started_ms=$((started_epoch * 1000))
  if [[ -n "$session_id" ]]; then
    progress_initial_lines="$(session_line_count "$session_id")"
  fi
  output_file="$(mktemp -t lark-codex-output.XXXXXX)"
  : >"$TASK_LOG_FILE"
  if [[ -n "$session_id" ]]; then
    set_status "running" "$task_id" "$message_id" "$prompt" "正在发送到会话 $session_id"
  else
    set_status "running" "$task_id" "$message_id" "$prompt" "Codex 正在执行"
  fi
  [[ -n "$job_id" ]] && job_update_state "$job_id" "running" "$task_id" "$message_id" "$prompt" "$session_id" "" ""
  terminal_update_card "$message_id" "RUNNING" "$(terminal_buffer_text "$message_id" "working...")" "$task_id" "$prompt" "$session_id" "0" "$job_id" "" "false" || true

  {
    echo "$(timestamp) task_id=$task_id started"
    echo "model=$CODEX_MODEL"
    echo "workdir=${CHAT_WORKDIR:-$CODEX_WORKDIR}"
    echo "timeout=${timeout_seconds}s"
    [[ -n "$job_id" ]] && echo "job_id=$job_id"
    [[ -n "$session_id" ]] && echo "resume_session=$session_id"
    echo
  } >>"$TASK_LOG_FILE"

  if [[ -n "$session_id" ]]; then
    if [[ "$LARK_CODEX_DANGEROUS_BYPASS" == "true" ]]; then
      resume_args+=(--dangerously-bypass-approvals-and-sandbox)
    fi
    (
      printf '%s' "$prompt" |
        "$CODEX_BIN" exec resume \
          -m "$CODEX_MODEL" \
          --skip-git-repo-check \
          "${resume_args[@]}" \
          -o "$output_file" \
          "$session_id" \
          -
    ) >>"$TASK_LOG_FILE" 2>&1 &
    codex_pid=$!
    write_running_lock_pid "$codex_pid"
    progress_stop_file="$(terminal_stop_file_path "$message_id")"
    rm -f "$progress_stop_file"
    terminal_progress_loop "$message_id" "$task_id" "$prompt" "$session_id" "$started_ms" "$started_epoch" "$job_id" "$codex_pid" "$progress_stop_file" "$progress_initial_lines" &
    progress_pid=$!
    if wait_with_timeout "$codex_pid" "$timeout_seconds"; then
      codex_exit=0
    else
      codex_exit=$?
    fi
  else
    (
      printf '%s' "$prompt" |
        "$CODEX_BIN" exec \
          -C "${CHAT_WORKDIR:-$CODEX_WORKDIR}" \
          -m "$CODEX_MODEL" \
          --skip-git-repo-check \
          --full-auto \
          -o "$output_file" \
          -
    ) >>"$TASK_LOG_FILE" 2>&1 &
    codex_pid=$!
    write_running_lock_pid "$codex_pid"
    progress_stop_file="$(terminal_stop_file_path "$message_id")"
    rm -f "$progress_stop_file"
    terminal_progress_loop "$message_id" "$task_id" "$prompt" "$session_id" "$started_ms" "$started_epoch" "$job_id" "$codex_pid" "$progress_stop_file" "$progress_initial_lines" &
    progress_pid=$!
    if wait_with_timeout "$codex_pid" "$timeout_seconds"; then
      codex_exit=0
    else
      codex_exit=$?
    fi
  fi

  if [[ -n "${progress_pid:-}" ]]; then
    [[ -n "$progress_stop_file" ]] && : >"$progress_stop_file"
    wait "$progress_pid" 2>/dev/null || true
    [[ -n "$progress_stop_file" ]] && rm -f "$progress_stop_file"
  fi

  if [[ -n "$job_id" && -z "$session_id" ]]; then
    new_session_id="$(latest_created_session_id_since "$started_ms" "${CHAT_WORKDIR:-$CODEX_WORKDIR}" || true)"
    if [[ -n "$new_session_id" ]]; then
      session_id="$new_session_id"
      job_update_state "$job_id" "running" "$task_id" "$message_id" "$prompt" "$session_id" "" ""
      echo "$(timestamp) task_id=$task_id job_session=$session_id" >>"$TASK_LOG_FILE"
    fi
  fi

  if ((codex_exit == 0)); then
    local answer
    answer="$(cat "$output_file")"
    [[ -n "$answer" ]] || answer="Codex finished, but did not return a final message."
    if [[ "$reply_mode" == "new_session" ]]; then
      if [[ -z "$session_id" ]]; then
        new_session_id="$(latest_created_session_id_since "$started_ms" "${CHAT_WORKDIR:-$CODEX_WORKDIR}" || true)"
        [[ -n "$new_session_id" ]] && session_id="$new_session_id"
      fi
      if [[ -n "$session_id" ]]; then
        set_active_session "$session_id"
        echo "$(timestamp) task_id=$task_id new_session=$session_id" >>"$TASK_LOG_FILE"
      else
        echo "$(timestamp) task_id=$task_id warning=new_session_id_not_found" >>"$TASK_LOG_FILE"
      fi
    fi
    echo "$(timestamp) task_id=$task_id completed" >>"$TASK_LOG_FILE"
    set_status "completed" "$task_id" "$message_id" "$prompt" "已回复结果"
    elapsed_seconds=$(($(date '+%s') - started_epoch))
    if [[ -n "$job_id" ]]; then
      job_refresh_artifacts "$job_id" || true
      job_update_state "$job_id" "completed" "$task_id" "$message_id" "$prompt" "$session_id" "$elapsed_seconds" ""
    fi
    reply_result "$message_id" "success" "$answer" "$task_id" "$prompt" "$session_id" "$elapsed_seconds" || echo "Failed to reply to $message_id" >&2
  else
    echo "$(timestamp) task_id=$task_id failed" >>"$TASK_LOG_FILE"
    elapsed_seconds=$(($(date '+%s') - started_epoch))
    failure_reason="Codex failed while handling this request."
    result_status="failed"
    if ((codex_exit == 124)); then
      failure_reason="任务超过 ${timeout_seconds}s，已暂停。"
      result_status="paused"
    fi
    set_status "$result_status" "$task_id" "$message_id" "$prompt" "发送 continue 继续，或发送 logs 查看最近日志"
    failure_answer="$failure_reason"
    if [[ -n "$job_id" ]]; then
      job_refresh_artifacts "$job_id" || true
      job_update_state "$job_id" "$result_status" "$task_id" "$message_id" "$prompt" "$session_id" "$elapsed_seconds" "$failure_reason"
      failure_answer="$(long_task_failure_text "$job_id" "$elapsed_seconds" "$failure_reason")"
    fi
    reply_result "$message_id" "$result_status" "$failure_answer" "$task_id" "$prompt" "$session_id" "$elapsed_seconds" || true
  fi

  rm -f "$output_file"
  pop_queue_task || true
  clear_running_lock
}

echo "$(timestamp) Listening for Feishu messages from the allowed sender" >&2
refresh_tenant_token
queue_watch_loop &

lark-cli event +subscribe \
  --event-types im.message.receive_v1 \
  --compact \
  --quiet |
while IFS= read -r line; do
  raw_content="$(jq -r '.content // empty' <<<"$line")"
  message_id="$(jq -r '.message_id // empty' <<<"$line")"
  sender_id="$(jq -r '.sender_id // empty' <<<"$line")"
  chat_id="$(jq -r '.chat_id // .chat.id // empty' <<<"$line")"

  [[ -n "$raw_content" && -n "$message_id" ]] || continue

  echo "$(timestamp) command message_id=$message_id sender_id=$sender_id chat_id=$chat_id content_length=${#raw_content}" >&2

  if [[ -n "$ALLOWED_SENDER" && "$sender_id" != "$ALLOWED_SENDER" ]]; then
    echo "$(timestamp) ignored sender_id=$sender_id; allowed_sender=$ALLOWED_SENDER" >&2
    continue
  fi

  [[ -n "$chat_id" ]] || chat_id="unknown"
  chat_context_load "$chat_id"

  prompt="$(extract_text_from_content "$raw_content" 2>/dev/null || true)"
  prompt="$(normalize_prompt "$prompt")"
  ack_message "$message_id" || true

  if [[ -z "$prompt" ]]; then
    reply "$message_id" "收到。直接发送要我处理的内容即可。发送 目录 查看会话编号，help 查看命令。"
    continue
  fi

  case "$prompt" in
    status|状态)
      reply_status "$message_id"
      continue
      ;;
    logs|日志)
      reply_notice "$message_id" "Logs" "blue" "$(logs_text)" "命令：status / 目录 / 队列" "$(logs_text)"
      continue
      ;;
    queue|队列)
      reply_notice "$message_id" "Queue" "blue" "$(queue_text)" "命令：status / logs" "$(queue_text)"
      continue
      ;;
    help|帮助)
      reply_notice "$message_id" "terminal help" "blue" "sessions\ncurrent\nattach 1\ndetach\nnew <prompt>\nnew session <prompt>\ncontinue\ntask / tasks\nqueue\nlogs\npwd\ncd /path\n\n普通消息默认进入当前会话；没有当前会话时创建新 terminal task。" "中文命令仍兼容：目录 / 切换 N / 清除会话 / 新会话 / 继续任务 / 队列" "sessions / current / attach 1 / detach / new <prompt> / continue / task / queue / logs / pwd / cd"
      continue
      ;;
    目录|会话目录|sessions|"session list")
      reply_directory "$message_id"
      continue
      ;;
  esac

  if [[ "$prompt" =~ ^(当前会话|current)$ ]]; then
    reply_current_session "$message_id"
    continue
  fi

  if [[ "$prompt" =~ ^(清除会话|取消会话|detach)$ ]]; then
    detach_active_session "$message_id"
    continue
  fi

  if [[ "$prompt" =~ ^(pwd)$ ]]; then
    reply_pwd "$message_id"
    continue
  fi

  if [[ "$prompt" =~ ^(cd|cwd)[[:space:]]+(.+)$ ]]; then
    cmd_cd "$message_id" "${BASH_REMATCH[2]}"
    continue
  fi

  if [[ "$prompt" =~ ^debug([[:space:]]+(.+))?$ ]]; then
    cmd_debug "$message_id" "${BASH_REMATCH[2]:-}"
    continue
  fi

  if [[ "$prompt" =~ ^(syncmode|同步模式)[[:space:]]+([^[:space:]]+)$ ]]; then
    cmd_syncmode "$message_id" "${BASH_REMATCH[2]}"
    continue
  fi

  if [[ "$prompt" =~ ^(update|更新)([[:space:]]+(.+))?$ ]]; then
    cmd_update_mode "$message_id" "${BASH_REMATCH[3]:-}"
    continue
  fi

  if [[ "$prompt" =~ ^(tasks|jobs)([[:space:]]+(.+))?$ ]]; then
    if [[ -n "${BASH_REMATCH[3]:-}" ]]; then
      reply_job_status "$message_id" "${BASH_REMATCH[3]}"
    else
      reply_notice "$message_id" "tasks" "blue" "$(jobs_list_text)" "commands: task / continue / queue / logs" "$(jobs_list_text)"
    fi
    continue
  fi

  if [[ "$prompt" =~ ^(任务|task|job)([[:space:]]+(.+))?$ ]]; then
    reply_job_status "$message_id" "${BASH_REMATCH[3]:-}"
    continue
  fi

  if [[ "$prompt" =~ ^(继续任务|继续做任务|继续长任务|continue[[:space:]]+task|resume[[:space:]]+task|continue|resume)([[:space:]]+(.+))?$ ]]; then
    continue_long_task "$message_id" "${BASH_REMATCH[3]:-}"
    continue
  fi

  if [[ "$prompt" =~ ^(长任务|long[[:space:]]+task|long)[[:space:]]+(.+)$ ]]; then
    prompt="${BASH_REMATCH[2]}"
    start_long_task "$message_id" "$prompt"
    continue
  fi

  if [[ "$prompt" =~ ^(新会话|新对话|new[[:space:]]+session|new[[:space:]]+chat)$ ]]; then
    set_new_session_pending
    reply_notice "$message_id" "新会话" "blue" "已准备创建新会话。下一条普通消息会创建并常驻到这个新会话。" "命令：清除会话 可取消当前常驻；切换 N 可切到已有会话。" "已准备创建新会话。下一条普通消息会创建并常驻到这个新会话。"
    continue
  fi

  if [[ "$prompt" =~ ^(新会话|新对话)[[:space:]]+(.+)$ ]]; then
    prompt="${BASH_REMATCH[2]}"
    start_new_session_task "$message_id" "$prompt"
    continue
  fi

  if [[ "$prompt" =~ ^(new[[:space:]]+session|new[[:space:]]+chat)[[:space:]]+(.+)$ ]]; then
    prompt="${BASH_REMATCH[2]}"
    start_new_session_task "$message_id" "$prompt"
    continue
  fi

  if [[ "$prompt" =~ ^(会话|session)[[:space:]]+([^[:space:]]+)$ ]]; then
    reply_notice "$message_id" "会话进度" "blue" "$(session_summary_text "${BASH_REMATCH[2]}")" "命令：切换 N / 同步会话 N 10分钟" "$(session_summary_text "${BASH_REMATCH[2]}")"
    continue
  fi

  if [[ "$prompt" =~ ^(置顶|pin)[[:space:]]+([^[:space:]]+)$ ]]; then
    pin_session_ref "$message_id" "${BASH_REMATCH[2]}"
    continue
  fi

  if [[ "$prompt" =~ ^(取消置顶|unpin)[[:space:]]+([^[:space:]]+)$ ]]; then
    unpin_session_ref "$message_id" "${BASH_REMATCH[2]}"
    continue
  fi

  if [[ "$prompt" =~ ^(停止同步|stop[[:space:]]+sync|sync[[:space:]]+stop)$ ]]; then
    stop_sync "$message_id"
    continue
  fi

  if [[ "$prompt" =~ ^(切换会话|切换到|切换|switch|attach|常驻会话|常驻|stick|persist)[[:space:]]*([^[:space:]]+)([[:space:]]+(.+))?$ ]]; then
    session_ref="${BASH_REMATCH[2]}"
    duration_text="${BASH_REMATCH[4]:-}"
    if [[ -n "$duration_text" ]]; then
      sync_seconds="$(parse_duration_seconds "$duration_text" || true)"
      if [[ -z "$sync_seconds" ]]; then
        reply "$message_id" "切换时长没看懂。可以发：切换 2 10分钟"
        continue
      fi
      switch_session_ref "$message_id" "$session_ref" "$sync_seconds"
    else
      switch_session_ref "$message_id" "$session_ref"
    fi
    continue
  fi

  if [[ "$prompt" =~ ^(同步会话|sync[[:space:]]+session)[[:space:]]+([^[:space:]]+)([[:space:]]+(.+))?$ ]]; then
    session_ref="${BASH_REMATCH[2]}"
    duration_text="${BASH_REMATCH[4]:-}"
    session_id="$(resolve_session_ref "$session_ref" || true)"
    if [[ -z "$session_id" ]]; then
      reply "$message_id" "没有找到这个会话编号。发送 目录 查看当前可用编号。"
      continue
    fi
    sync_seconds="$(parse_duration_seconds "$duration_text" || true)"
    if [[ -z "$sync_seconds" ]]; then
      reply "$message_id" "同步时长没看懂。可以发：同步会话 1 10分钟"
      continue
    fi
    start_sync "$message_id" "$sync_seconds" "$session_id"
    continue
  fi

  if [[ "$prompt" =~ ^同步[[:space:]]+([^[:space:]]+)[[:space:]]+(.+)$ ]]; then
    session_ref="${BASH_REMATCH[1]}"
    duration_text="${BASH_REMATCH[2]}"
    session_id="$(resolve_session_ref "$session_ref" || true)"
    if [[ -n "$session_id" ]]; then
      sync_seconds="$(parse_duration_seconds "$duration_text" || true)"
      if [[ -z "$sync_seconds" ]]; then
        reply "$message_id" "同步时长没看懂。可以发：同步 1 10分钟"
        continue
      fi
      start_sync "$message_id" "$sync_seconds" "$session_id"
      continue
    fi
  fi

  if sync_seconds="$(parse_sync_seconds "$prompt")"; then
    start_sync "$message_id" "$sync_seconds"
    continue
  fi

  if [[ "$prompt" =~ ^(新任务|new)[[:space:]]+(.+)$ ]]; then
    prompt="${BASH_REMATCH[2]}"
    clear_new_session_pending
    if [[ "$TASK_MODE" == "auto-long" ]]; then
      start_long_task "$message_id" "$prompt" "" "false"
      continue
    fi
    if ! try_acquire_running_lock; then
      enqueue_task "$message_id" "$prompt" "" "final"
      continue
    fi

    task_id="$(date '+%Y%m%d%H%M%S')-$message_id"
    set_status "queued" "$task_id" "$message_id" "$prompt" "已进入后台执行"
    run_codex_task "$task_id" "$message_id" "$prompt" &
    continue
  fi

  if new_session_pending; then
    start_new_session_task "$message_id" "$prompt"
    continue
  fi

  attached_session_id="$(active_session_id || true)"
  if [[ -n "$attached_session_id" ]]; then
    if [[ "$TASK_MODE" == "auto-long" ]]; then
      start_long_task "$message_id" "$prompt" "$attached_session_id"
      continue
    fi
    if ! try_acquire_running_lock; then
      enqueue_task "$message_id" "$prompt" "$attached_session_id" "stream"
      continue
    fi

    task_id="$(date '+%Y%m%d%H%M%S')-$message_id"
    set_status "queued" "$task_id" "$message_id" "$prompt" "已发送到会话 $attached_session_id"
    run_codex_task "$task_id" "$message_id" "$prompt" "$attached_session_id" "stream" &
    continue
  fi

  if [[ "$TASK_MODE" == "auto-long" ]]; then
    start_long_task "$message_id" "$prompt" "" "false"
    continue
  fi

  if ! try_acquire_running_lock; then
    enqueue_task "$message_id" "$prompt" "" "final"
    continue
  fi

  task_id="$(date '+%Y%m%d%H%M%S')-$message_id"
  set_status "queued" "$task_id" "$message_id" "$prompt" "已进入后台执行"
  run_codex_task "$task_id" "$message_id" "$prompt" &
done
