# Copy this file to ~/.lark-codex/.env and fill in your own values.
# Do not commit your real .env file.

# Feishu/Lark custom app credentials.
LARKSUITE_CLI_APP_ID=cli_xxxxxxxxxxxxxxxxx
LARKSUITE_CLI_APP_SECRET=replace_me

# Only this Feishu/Lark user open_id can control Codex through the bot.
# Keep this strict. Leaving it empty makes the bridge refuse to start.
LARK_CODEX_ALLOWED_SENDER=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional runtime settings.
LARK_CODEX_BASE_DIR=$HOME/.lark-codex
LARK_CODEX_WORKDIR=$HOME
LARK_CODEX_MODEL=gpt-5.2
LARK_CODEX_ACK_EMOJI=👀
LARK_CODEX_ACK_MODE=reaction
LARK_CODEX_ACK_REACTION_EMOJI=OK
LARK_CODEX_RESULT_FORMAT=card
LARK_CODEX_DIRECTORY_FORMAT=card
LARK_CODEX_MAX_REPLY_CHARS=12000
LARK_CODEX_TASK_TIMEOUT_SECONDS=900
LARK_CODEX_SYNC_MAX_SECONDS=3600

# Security switch.
# false: default safe mode. Resumed Codex tasks use normal Codex approvals/sandbox behavior.
# true: dangerous mode. Your allowed Feishu/Lark sender can remotely trigger Codex with
#       --dangerously-bypass-approvals-and-sandbox.
LARK_CODEX_DANGEROUS_BYPASS=false
